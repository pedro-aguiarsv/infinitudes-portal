---
// =============================================================
// CollaboratorAvatar.astro
// -------------------------------------------------------------
// Retrato circular de uma colaboradora do Hub Infinito.
// Prioridade da foto: `photo` (Sanity) > `photoUrl` (estática) >
// fallback com as iniciais sobre fundo creme.
// =============================================================
import { urlFor, type Collaborator } from "../lib/sanity";
import { collaboratorInitials } from "../lib/collaborators";

interface Props {
  collaborator: Collaborator;
  size?: "sm" | "lg";
  /** Anel creme ao redor — usado na pilha sobreposta da faixa-teaser. */
  ring?: boolean;
}

const { collaborator, size = "lg", ring = false } = Astro.props;

const src = collaborator.photo
  ? urlFor(collaborator.photo)
      .width(320)
      .height(320)
      .fit("crop")
      .auto("format")
      .url()
  : (collaborator.photoUrl ?? null);

const alt = collaborator.photoAlt ?? collaborator.name;
const initials = collaboratorInitials(collaborator.name);

const sizeCls =
  size === "sm"
    ? "w-16 h-16 sm:w-[72px] sm:h-[72px] text-[15px]"
    : "w-24 h-24 md:w-28 md:h-28 text-2xl";
const ringCls = ring ? "ring-2 ring-paper" : "";
---

<div
  class={`relative ${sizeCls} rounded-full overflow-hidden bg-paper-soft ${ringCls} shrink-0`}
>
  {
    src ? (
      <img
        src={src}
        alt={alt}
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span
        aria-hidden="true"
        class="absolute inset-0 flex items-center justify-center font-serif text-ink/70 select-none"
      >
        {initials}
      </span>
    )
  }
</div>
