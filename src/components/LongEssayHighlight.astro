---
// =============================================================
// LongEssayHighlight.astro · Ensaio longo destacado na home
// -------------------------------------------------------------
// Reproduz o tratamento editorial das páginas internas já na home:
//   · Eyebrow bordô com categorias separadas por "·"
//   · Título display centralizado (até 2 linhas)
//   · Byline em meta uppercase
//   · Dropcap no primeiro parágrafo (Cormorant)
//   · CTA "Continuar lendo →" em bordô uppercase
// =============================================================

export interface Props {
  eyebrow?: string;
  title?: string;
  byline?: string;
  paragraphs?: string[];
  href?: string;
}

const {
  eyebrow = "Ensaio Longo · Hub Infinito",
  title = "O tempo que resta: notas sobre esperança e espiritualidade",
  byline = "Padre João Ribeiro · 18 min",
  paragraphs = [
    "Quando fui chamado pela primeira vez a acompanhar uma família em cuidados paliativos, pensei que meu papel seria consolar. Levei alguns anos para entender que o verdadeiro trabalho era outro, e muito mais silencioso: o de acompanhar sem pressa, sem respostas prontas, sem a urgência de preencher cada pausa com palavras bem intencionadas.",
    "A esperança realista não nega a finitude — ela habita o tempo que ainda resta com dignidade, atenção e presença. Essa foi a primeira lição que aprendi com pacientes, cuidadores e, sobretudo, com o silêncio dos quartos de hospital ao amanhecer…",
  ],
  href = "/hub-infinito/tempo-que-resta",
} = Astro.props;
---

<section class="bg-paper">
  <div class="max-w-3xl mx-auto px-6 py-24 lg:py-32">
    <header class="text-center">
      <p class="eyebrow">{eyebrow}</p>
      <h2
        class="font-serif text-[36px] sm:text-[44px] lg:text-[52px] leading-[1.1] mt-5 font-normal tracking-[-0.01em]"
      >
        <a href={href} class="transition-colors hover:text-rouge">
          {title}
        </a>
      </h2>
      <div class="meta mt-6">{byline}</div>
    </header>

    {
      paragraphs.map((p, i) => (
        <p
          class:list={[
            "font-serif text-[19px] lg:text-[20px] leading-[1.7] text-ink-soft",
            i === 0 ? "dropcap mt-12" : "mt-6",
          ]}
        >
          {p}
        </p>
      ))
    }

    <div class="text-center mt-14">
      <a
        href={href}
        class="font-sans text-[11px] font-medium tracking-[0.22em] uppercase text-rouge link-ed"
      >
        Continuar lendo →
      </a>
    </div>
  </div>
</section>
