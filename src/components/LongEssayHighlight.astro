---
// =============================================================
// LongEssayHighlight.astro · Destaque editorial da home
// -------------------------------------------------------------
// Reproduz o tratamento editorial das páginas internas já na home:
//   · Eyebrow bordô com categoria
//   · Título display centralizado (até 2 linhas)
//   · Byline em meta uppercase
//   · Dropcap no primeiro parágrafo (Cormorant)
//   · CTA configurável em bordô uppercase
//
// Atualmente alimenta a vitrine de RECOMENDAÇÕES (/recomenda) — pode
// ser parametrizado para qualquer outra categoria via props.
// =============================================================

export interface Props {
  eyebrow?: string;
  title?: string;
  byline?: string | null;
  paragraphs?: string[];
  href?: string;
  cta?: string;
}

const {
  eyebrow = "Recomenda",
  title = "Curadoria editorial em construção",
  byline = null,
  paragraphs = [
    "Uma curadoria de leituras, escutas e olhares selecionados pelo time editorial do (In)finitudes — recomendações que ampliam, com delicadeza, as conversas sobre presença, cuidado e finitude.",
  ],
  href = "/recomenda",
  cta = "Conhecer Recomenda →",
} = Astro.props;
---

<section class="bg-paper">
  <div class="max-w-3xl mx-auto px-6 py-24 lg:py-32">
    <header class="text-center">
      <p class="eyebrow">{eyebrow}</p>
      <h2
        class="font-serif text-[36px] sm:text-[44px] lg:text-[52px] leading-[1.1] mt-5 font-normal tracking-[-0.01em]"
      >
        <a href={href} class="transition-colors hover:text-rouge">
          {title}
        </a>
      </h2>
      {byline && <div class="meta mt-6">{byline}</div>}
    </header>

    {
      paragraphs.map((p, i) => (
        <p
          class:list={[
            "font-serif text-[19px] lg:text-[20px] leading-[1.7] text-ink-soft",
            i === 0 ? "dropcap mt-12" : "mt-6",
          ]}
        >
          {p}
        </p>
      ))
    }

    <div class="text-center mt-14">
      <a
        href={href}
        class="font-sans text-[11px] font-medium tracking-[0.22em] uppercase text-rouge link-ed"
      >
        {cta}
      </a>
    </div>
  </div>
</section>
