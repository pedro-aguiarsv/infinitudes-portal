---
// =============================================================
// Footer.astro · Rodapé institucional (In)finitudes
//   · Linha de links das seções (em creme)
//   · Bloco PRETO com a régua de fomento + redes sociais (mesma linha)
//   · Bloco CREME com copyright + links legais
//
// Régua de fomento (logos individuais claros, em uma única fileira):
//   · Patrocínio   → Lei Rouanet · Itaú
//   · Realização   → Ministério da Cultura · Bandeira do Brasil
//                     (período eleitoral; fora dele, Governo do Brasil)
// Os PNGs/WebPs em /public/footer/sponsors/ já são versões claras
// (texto branco + cores oficiais) preparadas pra fundo escuro.
// =============================================================
import { getNavItems } from "../lib/categories";
import { getSiteSettings, urlFor, type SponsorLogo } from "../lib/sanity";

const [settings, navItems] = await Promise.all([
  getSiteSettings(),
  getNavItems(),
]);

// ----- Patrocinadores / Realização -------------------------
// Se o Sanity tem itens cadastrados, usa eles. Senão, fallback
// estático com os logos já existentes em /public/footer/sponsors/.
// Patrocínio + Realização são renderizados numa única fileira.
type FooterLogo = {
  label: string;
  src: string;
  srcWebp?: string;
  /** classe Tailwind de altura. */
  h: string;
};

const FALLBACK_SPONSORS: FooterLogo[] = [
  {
    label: "Lei Rouanet",
    src: "/footer/sponsors/lei-rouanet.png",
    srcWebp: "/footer/sponsors/lei-rouanet.webp",
    h: "h-11",
  },
  {
    label: "Itaú",
    src: "/footer/sponsors/itau.png",
    srcWebp: "/footer/sponsors/itau.webp",
    h: "h-14",
  },
];

const FALLBACK_REALIZATION: FooterLogo[] = [
  {
    label: "Ministério da Cultura",
    src: "/footer/sponsors/min-cultura.png",
    srcWebp: "/footer/sponsors/min-cultura.webp",
    h: "h-9",
  },
  {
    // Período eleitoral: a marca institucional "Governo do Brasil" dá
    // lugar à Bandeira Nacional. Os arquivos governo-brasil.* seguem em
    // /public/footer/sponsors/ para facilitar reverter depois do pleito.
    label: "Bandeira do Brasil",
    src: "/footer/sponsors/bandeira-brasil.png",
    srcWebp: "/footer/sponsors/bandeira-brasil.webp",
    h: "h-12",
  },
];

function mapSanityLogo(s: SponsorLogo): FooterLogo {
  return {
    label: s.label,
    src: s.logo ? urlFor(s.logo).width(400).auto("format").url() : "",
    h: "h-9",
  };
}

const sponsors: FooterLogo[] =
  settings?.sponsors && settings.sponsors.length > 0
    ? settings.sponsors.map(mapSanityLogo)
    : FALLBACK_SPONSORS;

const realization: FooterLogo[] =
  settings?.realization && settings.realization.length > 0
    ? settings.realization.map(mapSanityLogo)
    : FALLBACK_REALIZATION;

// Fileira única de logos. O rótulo "Patrocínio" fica acima do último
// patrocinador (Itaú) e "Realização" acima do primeiro realizador
// (Ministério da Cultura), espelhando o layout da régua original.
type RowLogo = FooterLogo & { heading?: string };
const fomentoRow: RowLogo[] = [
  ...sponsors.map((s, i) => ({
    ...s,
    heading: i === sponsors.length - 1 ? "Patrocínio" : undefined,
  })),
  ...realization.map((s, i) => ({
    ...s,
    heading: i === 0 ? "Realização" : undefined,
  })),
];

// ----- Redes sociais ---------------------------------------
type SocialLink = {
  label: string;
  href: string;
  icon: "instagram" | "linkedin" | "spotify" | "youtube" | "mail";
};

const socialFromCMS: SocialLink[] = [];
if (settings?.social?.instagram)
  socialFromCMS.push({ label: "Instagram", href: settings.social.instagram, icon: "instagram" });
if (settings?.social?.youtube)
  socialFromCMS.push({ label: "YouTube", href: settings.social.youtube, icon: "youtube" });
if (settings?.social?.spotify)
  socialFromCMS.push({ label: "Spotify", href: settings.social.spotify, icon: "spotify" });
if (settings?.social?.linkedin)
  socialFromCMS.push({ label: "LinkedIn", href: settings.social.linkedin, icon: "linkedin" });

const SOCIAL: SocialLink[] =
  socialFromCMS.length > 0
    ? [...socialFromCMS, { label: "Contato", href: "/contato", icon: "mail" }]
    : [
        { label: "Instagram", href: "https://www.instagram.com/projetoinfinitudes/", icon: "instagram" },
        { label: "YouTube", href: "https://youtube.com/@projetoinfinitudes", icon: "youtube" },
        { label: "Spotify", href: "https://open.spotify.com/show/033rZdTQLNHMdwuJlaanAW", icon: "spotify" },
        { label: "Contato", href: "/contato", icon: "mail" },
      ];

const year = new Date().getFullYear();
const copyrightText =
  settings?.copyright ?? `© ${year} · Todos os direitos reservados`;
---

{/* Linha com nav das seções (fundo creme, mesma tipografia da topbar) */}
<div class="bg-paper border-t border-rule/60">
  <nav
    aria-label="Rodapé · seções"
    class="max-w-7xl mx-auto px-6 lg:px-12 py-6 flex flex-wrap items-center justify-center gap-x-8 md:gap-x-10 lg:gap-x-12 gap-y-3"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="font-sans text-[10px] font-medium uppercase tracking-[0.22em] text-ink/70 link-ed hover:text-rouge"
        >
          {item.title}
        </a>
      ))
    }
  </nav>
</div>

{/* Rodapé preto institucional · régua de fomento + redes sociais */}
<footer class="bg-black text-paper">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 py-10">
    <div
      class="relative flex flex-col items-center gap-8"
    >
      {/* Régua de fomento · centralizada (rótulos na mesma altura, logos pela base) */}
      <div
        class="flex items-end justify-center gap-6 sm:gap-8 flex-wrap"
      >
        {
          fomentoRow.map((s) => (
            <div class="flex flex-col items-center gap-3">
              <p class="font-sans text-[8px] tracking-[0.30em] uppercase text-paper/55 leading-none min-h-[0.7rem]">
                {s.heading ?? ""}
              </p>
              <div class="flex h-16 items-end">
                <picture>
                  {s.srcWebp && <source srcset={s.srcWebp} type="image/webp" />}
                  <img
                    src={s.src}
                    alt={s.label}
                    class={`${s.h} w-auto object-contain select-none`}
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                  />
                </picture>
              </div>
            </div>
          ))
        }
      </div>

      {/* Redes sociais · à direita no desktop, abaixo (centralizado) no mobile */}
      <div class="flex items-center gap-4 shrink-0 md:absolute md:right-0 md:top-1/2 md:-translate-y-1/2">
        {
          SOCIAL.map((s) => (
            <a
              href={s.href}
              aria-label={s.label}
              class="w-9 h-9 rounded-full border border-paper/40 flex items-center justify-center text-paper/85 hover:text-rouge hover:border-rouge transition-colors"
            >
                {s.icon === "instagram" && (
                  <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" />
                  </svg>
                )}
                {s.icon === "linkedin" && (
                  <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="currentColor"
                  >
                    <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.06c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.77 2.65 4.77 6.1V21h-4v-5.34c0-1.27-.03-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.81V21H9z" />
                  </svg>
                )}
                {s.icon === "spotify" && (
                  <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="currentColor"
                  >
                    <path d="M12 0a12 12 0 1 0 0 24A12 12 0 0 0 12 0zm5.52 17.34a.75.75 0 0 1-1.03.25c-2.82-1.72-6.38-2.11-10.56-1.16a.75.75 0 1 1-.33-1.46c4.57-1.04 8.5-.6 11.66 1.34.36.22.47.69.26 1.03zm1.47-3.29a.94.94 0 0 1-1.29.31c-3.23-1.98-8.15-2.56-11.97-1.4a.94.94 0 1 1-.55-1.8c4.37-1.33 9.78-.69 13.5 1.6.45.27.59.86.31 1.29zm.13-3.43c-3.87-2.3-10.27-2.51-13.97-1.39a1.13 1.13 0 1 1-.66-2.16c4.24-1.29 11.3-1.04 15.76 1.6a1.13 1.13 0 1 1-1.13 1.95z" />
                  </svg>
                )}
                {s.icon === "youtube" && (
                  <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="currentColor"
                  >
                    <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z" />
                  </svg>
                )}
                {s.icon === "mail" && (
                  <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                  >
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3 7 9 6 9-6" />
                  </svg>
                )}
              </a>
            ))
          }
      </div>
    </div>
  </div>
</footer>

{/* Linha de copyright + links legais · mesma faixa preta */}
<section class="bg-black text-paper border-t border-paper/15">
  <div
    class="max-w-7xl mx-auto px-6 lg:px-12 py-4 flex flex-col sm:flex-row gap-3 sm:gap-6 justify-between items-center"
  >
    <div class="flex items-center gap-5">
      <a
        href="/privacidade"
        class="font-sans text-[10px] tracking-[0.22em] uppercase text-paper/55 hover:text-paper link-ed"
      >
        Privacidade
      </a>
      <a
        href="/termos"
        class="font-sans text-[10px] tracking-[0.22em] uppercase text-paper/55 hover:text-paper link-ed"
      >
        Termos
      </a>
      <a
        href="/contato"
        class="font-sans text-[10px] tracking-[0.22em] uppercase text-paper/55 hover:text-paper link-ed"
      >
        Contato
      </a>
    </div>
    <p
      class="font-sans text-[10px] tracking-[0.22em] uppercase text-paper/55"
    >
      {copyrightText}
    </p>
  </div>
</section>
