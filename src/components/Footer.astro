---
// =============================================================
// Footer.astro · Rodapé institucional (In)finitudes
//   · Linha de links das seções (em creme)
//   · Bloco PRETO com redes sociais
//   · Bloco CREME com a régua oficial de fomento
//   · Bloco CREME com copyright + links legais
//
// IMPORTANTE — Régua oficial de fomento (Lei Rouanet)
// -------------------------------------------------------------
// O kit oficial (Réguas.pdf) traz 5 variações. Usamos duas versões
// CLARAS (logos pretos + coloridos sobre fundo transparente),
// alternadas por viewport, sempre exibidas sobre faixa creme
// (bg-paper) — mesmo fundo da seção de Newsletter, garantindo
// legibilidade total das marcas conforme manual gráfico:
//   · DESKTOP (≥ 640px) → regua-fomento.{png,webp}
//       Régua HORIZONTAL CLARA, 9 marcas (Lei Rouanet · Itaú ·
//       Palácio das Artes · Circuito da Liberdade · Fundação Clóvis
//       Salgado · Cultura e Turismo · Gov MG · Min Cultura · Gov BR).
//   · MOBILE  (< 640px) → regua-fomento-mobile.{png,webp}
//       Régua VERTICAL CLARA, 9 marcas (página 3 do Réguas.pdf).
//       Mesma composição do desktop, empilhada para telas estreitas.
// Qualquer alteração estrutural na ORDEM/proporção deve substituir
// os arquivos, não recompor com markup.
// =============================================================
import { getNavItems } from "../lib/categories";
import { getSiteSettings } from "../lib/sanity";

const [settings, navItems] = await Promise.all([
  getSiteSettings(),
  getNavItems(),
]);

// Régua DESKTOP — versão clara horizontal (9 marcas, logos pretos +
// coloridos sobre fundo transparente). Proporção ~9.4:1.
const FOMENTO_PNG = "/footer/regua-fomento.png";
const FOMENTO_WEBP = "/footer/regua-fomento.webp";
const FOMENTO_ALT =
  "Régua oficial de fomento: Lei Rouanet · Patrocínio Itaú · Apoio Palácio das Artes, Circuito Liberdade, Fundação Clóvis Salgado, Cultura e Turismo de Minas, Governo de Minas · Realização Ministério da Cultura, Governo do Brasil";

// Régua MOBILE — versão clara vertical (oficial Réguas.pdf página 3),
// MESMAS 9 marcas do desktop empilhadas para telas estreitas.
// Proporção ~0.41:1.
const FOMENTO_MOBILE_PNG = "/footer/regua-fomento-mobile.png";
const FOMENTO_MOBILE_WEBP = "/footer/regua-fomento-mobile.webp";
const FOMENTO_MOBILE_ALT = FOMENTO_ALT;

// ----- Redes sociais ---------------------------------------
type SocialLink = {
  label: string;
  href: string;
  icon: "instagram" | "linkedin" | "spotify" | "youtube" | "mail";
};

const socialFromCMS: SocialLink[] = [];
if (settings?.social?.instagram)
  socialFromCMS.push({ label: "Instagram", href: settings.social.instagram, icon: "instagram" });
if (settings?.social?.youtube)
  socialFromCMS.push({ label: "YouTube", href: settings.social.youtube, icon: "youtube" });
if (settings?.social?.spotify)
  socialFromCMS.push({ label: "Spotify", href: settings.social.spotify, icon: "spotify" });
if (settings?.social?.linkedin)
  socialFromCMS.push({ label: "LinkedIn", href: settings.social.linkedin, icon: "linkedin" });

const SOCIAL: SocialLink[] =
  socialFromCMS.length > 0
    ? [...socialFromCMS, { label: "Contato", href: "/contato", icon: "mail" }]
    : [
        { label: "Instagram", href: "https://www.instagram.com/projetoinfinitudes/", icon: "instagram" },
        { label: "YouTube", href: "https://youtube.com/@projetoinfinitudes", icon: "youtube" },
        { label: "Spotify", href: "https://open.spotify.com/user/31uwpv77x55gctgdwpiwmczvgmfi", icon: "spotify" },
        { label: "Contato", href: "/contato", icon: "mail" },
      ];

const year = new Date().getFullYear();
const copyrightText =
  settings?.copyright ?? `© ${year} · Todos os direitos reservados`;
---

{/* Linha com nav das seções (fundo creme, mesma tipografia da topbar) */}
<div class="bg-paper border-t border-rule/60">
  <nav
    aria-label="Rodapé · seções"
    class="max-w-7xl mx-auto px-6 lg:px-12 py-6 flex flex-wrap items-center justify-center gap-x-8 md:gap-x-10 lg:gap-x-12 gap-y-3"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="font-sans text-[10px] font-medium uppercase tracking-[0.22em] text-ink/70 link-ed hover:text-rouge"
        >
          {item.title}
        </a>
      ))
    }
  </nav>
</div>

{/* Rodapé preto institucional — APENAS redes sociais */}
<footer class="bg-black text-paper">
  <div
    class="max-w-7xl mx-auto px-6 lg:px-12 py-12 flex justify-center"
  >
    {/* Redes sociais centralizadas */}
    <div class="flex justify-center">
      <div class="flex flex-col items-center gap-3">
        <p
          class="font-sans text-[9px] tracking-[0.30em] uppercase text-paper/55"
        >
          {SOCIAL.map((s) => s.label).join(" · ")}
        </p>
        <div class="flex items-center gap-4">
          {
            SOCIAL.map((s) => (
              <a
                href={s.href}
                aria-label={s.label}
                class="w-9 h-9 rounded-full border border-paper/40 flex items-center justify-center text-paper/85 hover:text-rouge hover:border-rouge transition-colors"
              >
                {s.icon === "instagram" && (
                  <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" />
                  </svg>
                )}
                {s.icon === "linkedin" && (
                  <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="currentColor"
                  >
                    <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.06c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.77 2.65 4.77 6.1V21h-4v-5.34c0-1.27-.03-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.81V21H9z" />
                  </svg>
                )}
                {s.icon === "spotify" && (
                  <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="currentColor"
                  >
                    <path d="M12 0a12 12 0 1 0 0 24A12 12 0 0 0 12 0zm5.52 17.34a.75.75 0 0 1-1.03.25c-2.82-1.72-6.38-2.11-10.56-1.16a.75.75 0 1 1-.33-1.46c4.57-1.04 8.5-.6 11.66 1.34.36.22.47.69.26 1.03zm1.47-3.29a.94.94 0 0 1-1.29.31c-3.23-1.98-8.15-2.56-11.97-1.4a.94.94 0 1 1-.55-1.8c4.37-1.33 9.78-.69 13.5 1.6.45.27.59.86.31 1.29zm.13-3.43c-3.87-2.3-10.27-2.51-13.97-1.39a1.13 1.13 0 1 1-.66-2.16c4.24-1.29 11.3-1.04 15.76 1.6a1.13 1.13 0 1 1-1.13 1.95z" />
                  </svg>
                )}
                {s.icon === "youtube" && (
                  <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="currentColor"
                  >
                    <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z" />
                  </svg>
                )}
                {s.icon === "mail" && (
                  <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                  >
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3 7 9 6 9-6" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</footer>

{/*
  Régua oficial de fomento + copyright — em fundo creme (bg-paper),
  mesmo fundo da seção de Newsletter, garantindo legibilidade total
  das marcas conforme manual gráfico oficial.
    · ≥ 640px (sm) → régua horizontal clara, 9 marcas
    · < 640px      → régua vertical clara, 9 marcas (página 3 do PDF)
*/}
<section class="bg-paper text-ink">
  <div class="px-6 lg:px-12 py-8 lg:py-9">
    {/* Mobile: régua vertical clara (9 marcas empilhadas) */}
    <picture class="block sm:hidden mx-auto max-w-[260px]">
      <source srcset={FOMENTO_MOBILE_WEBP} type="image/webp" />
      <img
        src={FOMENTO_MOBILE_PNG}
        alt={FOMENTO_MOBILE_ALT}
        class="w-full h-auto select-none"
        loading="lazy"
        decoding="async"
        draggable="false"
      />
    </picture>
    {/* Desktop: régua horizontal completa (9 marcas) */}
    <picture class="hidden sm:block max-w-6xl mx-auto">
      <source srcset={FOMENTO_WEBP} type="image/webp" />
      <img
        src={FOMENTO_PNG}
        alt={FOMENTO_ALT}
        class="w-full h-auto select-none"
        loading="lazy"
        decoding="async"
        draggable="false"
      />
    </picture>
  </div>

  {/* Linha de copyright + links legais — também em creme */}
  <div class="border-t border-rule/60">
    <div
      class="max-w-7xl mx-auto px-6 lg:px-12 py-4 flex flex-col sm:flex-row gap-3 sm:gap-6 justify-between items-center"
    >
      <div class="flex items-center gap-5">
        <a
          href="/privacidade"
          class="font-sans text-[10px] tracking-[0.22em] uppercase text-ink/55 hover:text-ink link-ed"
        >
          Privacidade
        </a>
        <a
          href="/termos"
          class="font-sans text-[10px] tracking-[0.22em] uppercase text-ink/55 hover:text-ink link-ed"
        >
          Termos
        </a>
        <a
          href="/contato"
          class="font-sans text-[10px] tracking-[0.22em] uppercase text-ink/55 hover:text-ink link-ed"
        >
          Contato
        </a>
      </div>
      <p
        class="font-sans text-[10px] tracking-[0.22em] uppercase text-ink/55"
      >
        {copyrightText}
      </p>
    </div>
  </div>
</section>
