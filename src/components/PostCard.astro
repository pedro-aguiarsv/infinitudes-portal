---
// =============================================================
// PostCard.astro · Miniatura editorial de post
// -------------------------------------------------------------
// Uso:
//   <PostCard post={post} category="Divã Infinito" />
//
// Estrutura conforme o design (IN)Finitudes:
//   ┌─────────────────┐
//   │   IMAGEM 4:3    │   (ou outra ratio via prop)
//   ├─────────────────┤
//   │ CATEGORIA       │   eyebrow bordô uppercase
//   │ Título serif    │
//   │ Descrição body  │
//   │ POR AUTOR       │   meta bordô
//   │ DATA            │   meta muted
//   └─────────────────┘
// =============================================================
import { urlFor, type PostPreview } from "../lib/sanity";
import { getCategory } from "../lib/categories";

export interface Props {
  post: PostPreview;
  category?: string; // Sobrescreve o label da categoria (opcional)
  author?: string; // Ex.: "Por Eleonora Cruz Santos"
  meta?: string; // Sobrescreve o rodapé (ex.: "Marina Pires · 6 min")
  imageRatio?: string; // Tailwind aspect: "aspect-[4/3]" (default), "aspect-[4/5]"...
  size?: "sm" | "md" | "lg";
}

const {
  post,
  category,
  author,
  meta,
  imageRatio = "aspect-[4/3]",
  size = "md",
} = Astro.props;

const categoryLabel =
  category ?? (post.category ? (getCategory(post.category)?.title ?? null) : null);

const postHref = post.category
  ? `/${post.category}/${post.slug}`
  : `/${post.slug}`;

const imageUrl = post.mainImage
  ? urlFor(post.mainImage).width(800).height(600).fit("crop").auto("format").url()
  : null;

const formattedDate = post.publishedAt
  ? new Intl.DateTimeFormat("pt-BR", {
      day: "numeric",
      month: "short",
      year: "numeric",
    }).format(new Date(post.publishedAt))
  : null;

const titleSize = {
  sm: "text-[18px] lg:text-[20px]",
  md: "text-[20px] lg:text-[22px]",
  lg: "text-[24px] lg:text-[28px]",
}[size];
---

<article class="group">
  <a href={postHref} class="block">
    {
      imageUrl ? (
        <img
          src={imageUrl}
          alt={post.mainImage?.alt ?? post.title}
          class={`w-full ${imageRatio} object-cover transition-[filter] duration-300 group-hover:brightness-95`}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class={`ph w-full ${imageRatio}`} data-label="Imagem" />
      )
    }

    {
      categoryLabel && (
        <span class="eyebrow mt-5 block">{categoryLabel}</span>
      )
    }

    <h3
      class={`font-display ${titleSize} leading-[1.18] mt-2 font-medium tracking-[-0.005em] transition-colors group-hover:text-rouge`}
    >
      {post.title}
    </h3>

    {
      post.excerpt && (
        <p class="font-serif text-[15px] lg:text-[16px] leading-[1.45] mt-3 text-ink/80">
          {post.excerpt}
        </p>
      )
    }

    {
      author && (
        <div class="mt-4 font-sans text-[10px] font-medium tracking-[0.20em] uppercase text-rouge">
          {author}
        </div>
      )
    }

    {
      meta ? (
        <div class="meta mt-2">{meta}</div>
      ) : (
        formattedDate && <div class="meta mt-2">{formattedDate}</div>
      )
    }
  </a>
</article>
