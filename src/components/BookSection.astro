---
// =============================================================
// BookSection.astro · Banner bordô do Livro (page-01, bloco 4)
// -------------------------------------------------------------
// Fundo bordô, duas colunas:
//   · Esquerda: capa do livro — composição com o branding
//     "(IN)FINITUDES" + aquarela vermelha (replica o design).
//     Se `coverUrl` for passado, usa a imagem real.
//   · Direita: título display em creme + dek + lista de features
//     com hairlines em paper/30 + CTA bordô-escuro pill.
//
// CTA aponta para a página do livro (/livro).
// =============================================================
import WatercolorAccent from "./WatercolorAccent.astro";
import Logo from "./Logo.astro";

export interface Props {
  title?: string;
  dek?: string;
  features?: Array<{ label: string; meta: string }>;
  coverUrl?: string | null;
  href?: string;
}

const {
  title = "InFinitudes: ensaios sobre a dor e a fé",
  dek = "Uma coletânea de ensaios sobre presença, escuta e a gramática silenciosa dos cuidados paliativos.",
  features = [
    { label: "Edição impressa com acabamento artesanal", meta: "320 páginas" },
    { label: "Prefácio de Dra. Ana Claudia Quintana Arantes", meta: "Exclusivo" },
    { label: "Inclui acesso ao áudio-livro narrado pelo autor", meta: "8h 40min" },
  ],
  coverUrl = null,
  href = "/livro",
} = Astro.props;
---

<section class="bg-rouge text-paper">
  <div class="max-w-6xl mx-auto px-6 lg:px-12 py-16 lg:py-20">
    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center"
    >
      {/* Capa do livro · composição (IN)FINITUDES + aquarela */}
      <figure class="lg:col-span-4 max-w-[260px] mx-auto lg:mx-0">
        {
          coverUrl ? (
            <img
              src={coverUrl}
              alt={`Capa do livro ${title}`}
              class="w-full aspect-[3/4] object-cover shadow-2xl"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div
              class="relative w-full aspect-[3/4] bg-paper text-ink shadow-2xl flex flex-col overflow-hidden"
            >
              {/* Logo oficial no topo da capa */}
              <div class="px-6 pt-6 relative z-10">
                <Logo variant="compact" class="w-[80%] h-auto" />
                <p
                  class="mt-3 font-sans text-[7px] tracking-[0.42em] uppercase text-ink/70"
                >
                  Divã Infinito
                </p>
              </div>
              {/* Aquarela vermelha cobrindo a metade inferior */}
              <div class="absolute inset-0 z-0">
                <WatercolorAccent
                  variant="rouge-blob"
                  class="absolute -bottom-6 -right-6 w-[105%] h-[60%] object-cover"
                />
              </div>
            </div>
          )
        }
      </figure>

      {/* Texto + lista + CTA */}
      <div class="lg:col-span-8">
        <h2
          class="font-display text-[36px] sm:text-[44px] lg:text-[52px] leading-[1.05] font-normal tracking-[-0.01em] text-paper"
        >
          {title}
        </h2>

        <p
          class="font-serif italic text-[18px] lg:text-[20px] leading-[1.45] mt-5 text-paper/85"
        >
          {dek}
        </p>

        {/* Features · hairlines em paper/30 */}
        <ul class="mt-10 border-t border-paper/30">
          {
            features.map((f) => (
              <li class="py-4 flex justify-between items-baseline gap-6 border-b border-paper/30">
                <span class="font-serif text-[15px] lg:text-[16px] text-paper">
                  {f.label}
                </span>
                <span class="font-sans text-[10px] font-medium tracking-[0.20em] uppercase text-paper/70 whitespace-nowrap">
                  {f.meta}
                </span>
              </li>
            ))
          }
        </ul>

        {/* CTA · botão em creme com texto bordô */}
        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a
            href={href}
            class="inline-flex items-center gap-2 bg-paper text-rouge px-8 py-3.5 text-[11px] font-medium tracking-[0.22em] uppercase hover:bg-paper/90 transition-colors"
          >
            Conheça o livro
          </a>
          <a
            href={`${href}#trecho`}
            class="font-sans text-[10px] font-medium tracking-[0.22em] uppercase text-paper/85 hover:text-paper link-ed"
          >
            Ler um trecho grátis →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
