---
// =============================================================
// NewsletterSection.astro
// -------------------------------------------------------------
// Bloco de captura de e-mail no estilo do design (page-01 / 02):
//   · Fundo creme, centralizado
//   · Eyebrow bordô "NOSSA NEWSLETTER"
//   · Título display "Receba nossos artigos"
//   · Input + botão bordô lado a lado
//
// A inscrição vai para /api/newsletter, que chama o Brevo no servidor.
// Pode ser inserido em qualquer página antes do Footer.
// =============================================================
---

<section id="newsletter" class="border-t border-rule/60 bg-paper">
  <div class="max-w-3xl mx-auto px-6 py-20 lg:py-24 text-center">
    <span class="eyebrow">Nossa Newsletter</span>
    <h3
      class="font-display text-3xl sm:text-4xl lg:text-[44px] leading-[1.1] mt-4 font-normal"
    >
      Receba nossos artigos
    </h3>
    <p class="font-serif text-[17px] leading-relaxed mt-5 text-ink/75 max-w-xl mx-auto">
      Assine nossa newsletter e receba nossas publicações.
    </p>

    <form id="newsletter-form" class="relative mt-10 max-w-lg mx-auto">
      <div class="flex flex-col sm:flex-row gap-3">
        <label for="newsletter-email" class="sr-only">Seu e-mail</label>
        <input
          id="newsletter-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="seu@email.com"
          class="flex-1 bg-transparent border border-rule px-5 py-3.5 text-[14px] placeholder:text-muted/70 focus:outline-none focus:border-rouge transition-colors disabled:opacity-60"
        />
        <button
          type="submit"
          class="bg-rouge text-paper px-8 py-3.5 text-[11px] font-medium tracking-[0.20em] uppercase hover:bg-rouge-deep transition-colors disabled:opacity-70 disabled:cursor-not-allowed"
        >
          Assine
        </button>
      </div>

      <label
        for="newsletter-consent"
        class="mt-4 flex items-start gap-2.5 text-left cursor-pointer"
      >
        <input
          id="newsletter-consent"
          name="consent"
          type="checkbox"
          required
          class="mt-0.5 h-4 w-4 shrink-0 accent-rouge disabled:opacity-60"
        />
        <span class="font-sans text-[12px] leading-[1.5] text-muted">
          Concordo em receber e-mails do (In)finitudes e li a
          <a href="/privacidade" class="underline hover:text-rouge">Política de Privacidade</a>.
        </span>
      </label>

      <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
        <label for="newsletter-company">Empresa</label>
        <input
          id="newsletter-company"
          name="company"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>
    </form>
    <p
      id="newsletter-status"
      role="status"
      aria-live="polite"
      class="meta mt-4"
      data-default="Grátis · cancele quando quiser"
    >
      Grátis · cancele quando quiser
    </p>
  </div>
</section>

<script>
  const form = document.getElementById("newsletter-form") as HTMLFormElement | null;

  if (form) {
    const input = document.getElementById("newsletter-email") as HTMLInputElement;
    const consent = document.getElementById("newsletter-consent") as HTMLInputElement;
    const company = document.getElementById("newsletter-company") as HTMLInputElement;
    const status = document.getElementById("newsletter-status");
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const failureMessage =
      "Não foi possível enviar agora. Tente novamente em instantes.";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!button) return;

      button.disabled = true;
      input.disabled = true;
      consent.disabled = true;
      const previousLabel = button.textContent;
      button.textContent = "Enviando…";
      if (status) status.classList.remove("text-rouge");

      const restore = (message: string) => {
        button.disabled = false;
        input.disabled = false;
        consent.disabled = false;
        button.textContent = previousLabel ?? "Assine";
        if (status) {
          status.textContent = message;
          status.classList.add("text-rouge");
        }
      };

      try {
        const response = await fetch("/api/newsletter", {
          method: "POST",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify({
            email: input.value.trim(),
            consent: consent.checked,
            company: company?.value ?? "",
          }),
        });

        if (!response.ok) {
          let message = failureMessage;
          try {
            const data = (await response.json()) as { error?: unknown };
            if (typeof data.error === "string" && data.error) message = data.error;
          } catch {
            // Mantém a mensagem genérica.
          }
          restore(message);
          return;
        }

        form.reset();
        form.style.display = "none";
        if (status) {
          status.textContent =
            "Inscrição feita! A partir de agora você recebe nossas publicações por e-mail.";
        }
      } catch {
        restore(failureMessage);
      }
    });
  }
</script>
