---
// =============================================================
// Header.astro · Cabeçalho editorial (In)finitudes
//   · Top bar: data à esquerda · Contato + Newsletter à direita
//   · Logo central oficial (imagem) + tagline "DIVÃ INFINITO"
//   · Linhas vermelhas finas demarcando a navegação
//   · Nav horizontal com itens em sans uppercase espaçado
//
// O e-mail mostrado na top-bar (quando houver espaço) e a tagline
// vêm de `siteSettings`. Quando o documento não existe, usa
// fallbacks editoriais. NUNCA quebra mesmo se Sanity está vazio.
// =============================================================
import { getNavItems } from "../lib/categories";
import Logo from "./Logo.astro";
import { getSiteSettings } from "../lib/sanity";

const [settings, navItems] = await Promise.all([
  getSiteSettings(),
  getNavItems(),
]);

// Topbar: link de contato (e-mail se cadastrado, senão página)
const contactHref = settings?.contactEmail
  ? `mailto:${settings.contactEmail}`
  : "/contato";
const contactLabel = settings?.contactEmail
  ? "Escreva para a redação"
  : "Contato";

const today = new Intl.DateTimeFormat("pt-BR", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(new Date());
---

<header class="bg-paper">
  {/* Top bar utilitária · data + links secundários */}
  <div class="border-b border-rule/70">
    <div
      class="max-w-7xl mx-auto px-6 lg:px-12 py-2.5 flex items-center justify-between gap-4"
    >
      <span class="meta capitalize">{today}</span>
      <div class="flex items-center gap-8">
        <a href={contactHref} class="meta link-ed hover:text-ink">{contactLabel}</a>
        <a href="#newsletter" class="meta link-ed hover:text-ink">
          Assine a Newsletter Semanal
        </a>
        <a href="/apoie" class="meta link-ed hover:text-ink">
          Quero ser um doador
        </a>
      </div>
    </div>
  </div>

  {/* Logo central (imagem oficial) — a tagline "DIVÃ INFINITO"
      já vem embutida na variante "header", não precisa de <p> extra. */}
  <div class="max-w-7xl mx-auto px-6 lg:px-12 py-8 lg:py-10 text-center">
    <a
      href="/"
      class="inline-block"
      aria-label="(In)finitudes — página inicial"
    >
      <Logo
        variant="header"
        loading="eager"
        class="h-28 sm:h-32 lg:h-40 w-auto mx-auto"
      />
    </a>
  </div>

  {/* Linha vermelha fina · navegação · linha vermelha fina */}
  <div class="rouge-line"></div>
  <nav aria-label="Navegação principal">
    <ul
      class="max-w-7xl mx-auto px-6 lg:px-12 py-5 flex flex-wrap items-center justify-center gap-x-7 md:gap-x-9 lg:gap-x-12 gap-y-3"
    >
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="font-sans text-[11px] font-medium uppercase tracking-[0.20em] text-ink/85 link-ed hover:text-rouge whitespace-nowrap"
            >
              {item.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="rouge-line"></div>
</header>
