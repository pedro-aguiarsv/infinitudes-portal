---
// =============================================================
// PostListItem.astro · Item de listagem horizontal (page-03)
// -------------------------------------------------------------
// Layout:
//   ┌──────────────────────────────────────┬──────────┐
//   │ Título serif (até 2 linhas)          │  IMAGEM  │
//   │ Descrição curta em body              │   1:1    │
//   │ POR AUTOR  (uppercase bordô)         │          │
//   │ DATA       (uppercase muted)         │          │
//   └──────────────────────────────────────┴──────────┘
//
// Pode ser usado em qualquer página de listagem (Hub Infinito,
// Curadoria, Recomenda, etc.). Divisores vermelhos finos são
// renderizados pelo container (PostList), não aqui.
// =============================================================
import { urlFor, type PostPreview } from "../lib/sanity";

export interface Props {
  post: PostPreview;
  author?: string; // Ex.: "Por Eleonora Cruz Santos"
  imageRatio?: string; // Tailwind aspect, default "aspect-[4/3]"
  /** Aquarela usada como capa quando o post não tem `mainImage`. Ex.:
   *  "/watercolors/rouge-blob.webp". Quando ausente, cai no placeholder neutro. */
  fallbackWatercolor?: string | null;
  /** Classes de tamanho do título (Tailwind). Permite reduzir o título em
   *  listagens específicas (ex.: Curadoria) sem afetar as demais. */
  titleSize?: string;
  /** Classes de tamanho do excerpt (Tailwind). Permite ajustar o corpo em
   *  listagens específicas (ex.: Curadoria) sem afetar as demais. */
  excerptSize?: string;
}

const {
  post,
  author,
  imageRatio = "aspect-[4/3]",
  fallbackWatercolor = null,
  titleSize = "text-[24px] sm:text-[28px] lg:text-[32px]",
  excerptSize = "text-[15px] lg:text-[16px]",
} = Astro.props;

// Byline: usa o prop explícito ou, se ausente, o campo `authors` do post.
// Exibe apenas o nome, sem o prefixo "Por" (ex.: "Por Fulano" → "Fulano").
const rawByline = author ?? post.authors ?? null;
const byline = rawByline ? rawByline.replace(/^\s*por\s+/i, "").trim() : null;

// Quando o post tem `externalUrl` (ex.: artigos de terceiros no Hub Infinito),
// o item aponta para o link externo e abre em nova aba; caso contrário usa a
// rota interna do post.
const hasExternal = Boolean(post.externalUrl);
const postHref = hasExternal
  ? post.externalUrl!
  : post.category
    ? `/${post.category}/${post.slug}`
    : `/${post.slug}`;
const linkAttrs = hasExternal
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};

const imageUrl = post.coverUrl
  ? post.coverUrl
  : post.mainImage
    ? urlFor(post.mainImage).width(700).height(525).fit("crop").auto("format").url()
    : null;
const imageAlt = post.coverAlt ?? post.mainImage?.alt ?? post.title;

const formattedDate = post.publishedAt
  ? new Intl.DateTimeFormat("pt-BR", {
      day: "numeric",
      month: "long",
      year: "numeric",
    }).format(new Date(post.publishedAt))
  : null;
---

<article class="group">
  <a
    href={postHref}
    {...linkAttrs}
    class="grid grid-cols-12 gap-6 lg:gap-12 py-10 lg:py-12 items-center"
  >
    {/* Texto · 7-8 colunas */}
    <div class="col-span-12 sm:col-span-8 order-2 sm:order-1">
      <h3
        class={`font-display ${titleSize} leading-[1.15] font-medium tracking-[-0.005em] transition-colors group-hover:text-rouge`}
      >
        {post.title}
      </h3>

      {
        post.excerpt && (
          <p class={`font-serif ${excerptSize} leading-[1.5] mt-3 text-ink/80 max-w-prose`}>
            {post.excerpt}
          </p>
        )
      }

      {
        byline && (
          <div class="mt-5 font-sans text-[10px] font-medium tracking-[0.20em] uppercase text-rouge">
            {byline}
          </div>
        )
      }

      {
        formattedDate && (
          <div class="meta mt-2">{formattedDate}</div>
        )
      }
    </div>

    {/* Imagem · 4-5 colunas à direita */}
    <div class="col-span-12 sm:col-span-4 order-1 sm:order-2">
      {
        imageUrl ? (
          <img
            src={imageUrl}
            alt={imageAlt}
            class={`w-full ${imageRatio} object-cover transition-[filter] duration-300 group-hover:brightness-95`}
            loading="lazy"
            decoding="async"
          />
        ) : fallbackWatercolor ? (
          <div class={`relative w-full ${imageRatio} overflow-hidden bg-paper-soft`}>
            <img
              src={fallbackWatercolor}
              alt=""
              role="presentation"
              aria-hidden="true"
              class="pointer-events-none select-none absolute inset-0 w-full h-full object-cover transition-[filter] duration-300 group-hover:brightness-95"
              loading="lazy"
              decoding="async"
              draggable="false"
            />
          </div>
        ) : (
          <div class={`ph w-full ${imageRatio}`} data-label="Imagem" />
        )
      }
    </div>
  </a>
</article>
