---
// =============================================================
// EpisodeListItem.astro · Item de listagem do Divã Infinito
// -------------------------------------------------------------
// Layout (page-07):
//   ┌──────────────────────────────┬──────────────┐
//   │ Divã Infinito Episódio N     │  Aquarela    │
//   │ Descrição do episódio        │  vermelha ou │
//   │                              │  preta       │
//   │ [ Começar a escutar  ]       │  "(IN)FINI   │
//   │ [ Todos os Episódios ]       │   TUDES" 0N  │
//   └──────────────────────────────┴──────────────┘
// =============================================================
import WatercolorAccent from "./WatercolorAccent.astro";

export interface Props {
  number: number; // ex.: 1, 2, 3 — usado pra exibir "01", "02"
  title?: string;
  description: string;
  href: string; // link do "Começar a escutar"
  allHref?: string; // link de "Todos os Episódios" (default /diva-infinito)
  variant?: "rouge" | "black"; // aquarela usada (alterna por episódio)
}

const {
  number,
  title,
  description,
  href,
  allHref = "/diva-infinito",
  variant = "rouge",
} = Astro.props;

const watercolor = variant === "rouge" ? "rouge-blob" : "black-blob";
const numStr = number.toString().padStart(2, "0");
const displayTitle = title ?? `Divã Infinito Episódio ${number}`;
---

<article
  class="grid grid-cols-12 gap-6 lg:gap-10 py-8 lg:py-10 items-center"
>
  {/* Texto + CTAs · 8 colunas */}
  <div class="col-span-12 sm:col-span-8 order-2 sm:order-1">
    <h3
      class="font-display text-[22px] sm:text-[26px] lg:text-[28px] leading-[1.15] font-medium tracking-[-0.005em]"
    >
      {displayTitle}
    </h3>

    <p
      class="font-serif text-[15px] lg:text-[16px] leading-[1.5] mt-2 text-ink/80 max-w-prose"
    >
      {description}
    </p>

    <div class="mt-5 flex flex-col gap-2 max-w-md">
      <a
        href={href}
        class="text-center bg-rouge text-paper px-6 py-2.5 text-[11px] font-medium tracking-[0.22em] uppercase hover:bg-rouge-deep transition-colors"
      >
        Começar a escutar
      </a>
      <a
        href={allHref}
        class="text-center border border-rouge text-rouge px-6 py-2.5 text-[11px] font-medium tracking-[0.22em] uppercase hover:bg-rouge hover:text-paper transition-colors"
      >
        Todos os Episódios
      </a>
    </div>
  </div>

  {/* Thumb · aquarela com (IN)FINITUDES sobreposto + número */}
  <div class="col-span-12 sm:col-span-4 order-1 sm:order-2 flex justify-center sm:justify-end">
    <div class="relative w-[200px] h-[200px] sm:w-[180px] sm:h-[180px] lg:w-[220px] lg:h-[220px]">
      <WatercolorAccent
        variant={watercolor}
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div
        class="absolute inset-0 flex items-center justify-center"
      >
        <div
          class="font-display leading-[0.95] tracking-[-0.01em] text-[18px] lg:text-[20px] font-medium text-ink"
        >
          <div><span class="text-rouge">(IN)</span></div>
          <div class="-mt-0.5">FINI</div>
          <div class="-mt-0.5">TUDES</div>
        </div>
      </div>
      <span
        class="absolute top-2 right-3 font-sans text-[12px] font-medium text-ink/80"
      >
        {numStr}
      </span>
    </div>
  </div>
</article>
