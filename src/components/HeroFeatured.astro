---
// =============================================================
// HeroFeatured.astro · "Capa de revista" da home (page-01)
// -------------------------------------------------------------
// Layout simplificado (sem headline):
//   ┌───────────────────────────────────────────────┐
//   │                                  ╭───────╮    │
//   │                                  │ aqua  │    │
//   │                                  │ rouge │    │
//   │                                  │       │    │
//   │                                  ╰───────╯    │
//   │  (IN)FINITUDES ◄─── horizontal, "(IN)" red,   │
//   │  Projeto cultural idealizado     "FINITUDES"  │
//   │  por Eleonora Santos             em preto.    │
//   └───────────────────────────────────────────────┘
//
// A aquarela fica posicionada absolutamente à direita
// (entra ATRÁS do masthead com z-index 0 vs z-index 10).
// =============================================================
import WatercolorAccent from "./WatercolorAccent.astro";
import Logo from "./Logo.astro";

export interface HeroContent {
  /** Linha editorial sob o masthead (ex.: assinatura do projeto). */
  edition?: string;
}

export interface Props {
  hero?: HeroContent;
}

const DEFAULT_EDITION = "Projeto cultural idealizado por Eleonora Santos";

const { hero = {} } = Astro.props;
const editionText = hero.edition ?? DEFAULT_EDITION;
---

<section class="relative">
  <div
    class="relative max-w-7xl mx-auto px-6 lg:px-12 pt-10 lg:pt-12 pb-16 lg:pb-20"
  >
    <div class="grid grid-cols-12 gap-6 items-center">
      {/* Coluna esquerda · masthead horizontal */}
      <div class="col-span-12 lg:col-span-7 order-2 lg:order-1 relative z-10">
        <div class="lg:pl-12">
          <Logo
            variant="compact"
            loading="eager"
            class="w-[220px] sm:w-[300px] lg:w-[360px] xl:w-[400px] h-auto"
            alt="(In)finitudes"
          />
          {
            editionText && (
              <p class="mt-3 lg:mt-4 font-sans text-[10px] tracking-[0.34em] uppercase text-ink/70">
                {editionText}
              </p>
            )
          }
        </div>
      </div>

      {/* Coluna direita · aquarela */}
      <div
        class="col-span-12 lg:col-span-5 order-1 lg:order-2 flex justify-center lg:justify-end"
      >
        <WatercolorAccent
          variant="rouge-blob-hero"
          loading="eager"
          class="w-[280px] sm:w-[360px] lg:w-[440px] xl:w-[500px] h-auto -mt-4 lg:-mt-8"
        />
      </div>
    </div>
  </div>
</section>
