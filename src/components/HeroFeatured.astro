---
// =============================================================
// HeroFeatured.astro · "Capa de revista" da home (page-01)
// -------------------------------------------------------------
// Refino editorial v4 (referência: The New Yorker):
//   · Sem logotipo gigante — o masthead já está no Header fixo.
//   · Manifesto editorial em Playfair italic à esquerda, com
//     ar e tipografia generosos.
//   · Aquarela bordô permanece à direita como peça gráfica.
//   · Linha de assinatura discreta em sans uppercase abaixo.
// =============================================================
import WatercolorAccent from "./WatercolorAccent.astro";

export interface HeroContent {
  /** Manifesto/subtítulo principal em serif italic (lead editorial). */
  manifesto?: string;
  /** Assinatura discreta sob o manifesto (ex.: idealização do projeto). */
  edition?: string;
}

export interface Props {
  hero?: HeroContent;
}

const DEFAULT_MANIFESTO =
  "Um espaço dedicado à humanização da saúde, ao cuidado e à escuta — uma gramática silenciosa do acompanhar.";
const DEFAULT_EDITION = "Projeto cultural idealizado por Eleonora Santos";

const { hero = {} } = Astro.props;
const manifestoText = hero.manifesto ?? DEFAULT_MANIFESTO;
const editionText = hero.edition ?? DEFAULT_EDITION;
---

<section class="relative">
  <div
    class="relative max-w-7xl mx-auto px-6 lg:px-12 pt-10 lg:pt-12 pb-16 lg:pb-20"
  >
    <div class="grid grid-cols-12 gap-6 items-center">
      {/* Coluna esquerda · manifesto editorial em serif italic */}
      <div class="col-span-12 lg:col-span-7 order-2 lg:order-1 relative z-10">
        <div class="lg:pl-12">
          <p
            class="font-serif italic font-normal text-[19px] sm:text-[22px] lg:text-[26px] xl:text-[30px] leading-[1.35] tracking-[-0.005em] text-ink max-w-[42ch] text-balance"
          >
            {manifestoText}
          </p>
          {
            editionText && (
              <p class="mt-6 lg:mt-8 font-sans text-[11px] tracking-[0.22em] uppercase text-stone-500">
                {editionText}
              </p>
            )
          }
        </div>
      </div>

      {/* Coluna direita · aquarela */}
      <div
        class="col-span-12 lg:col-span-5 order-1 lg:order-2 flex justify-center lg:justify-end"
      >
        <WatercolorAccent
          variant="rouge-blob-hero"
          loading="eager"
          class="w-[280px] sm:w-[360px] lg:w-[440px] xl:w-[500px] h-auto -mt-4 lg:-mt-8"
        />
      </div>
    </div>
  </div>
</section>
