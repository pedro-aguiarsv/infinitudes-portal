---
// =============================================================
// HeroFeatured.astro · "Capa de revista" da home (page-01)
// -------------------------------------------------------------
// Layout do mock:
//   ┌───────────────────────────────────────────────┐
//   │  Gwendoline Riley's            ╭───────╮     │
//   │  new novel surveys             │ aqua  │     │
//   │  the wreckage of               │ rouge │     │
//   │  middle age                    │       │     │
//   │                                ╰───────╯     │
//   │  (IN)FINITUDES ◄─── horizontal, "(IN)" red,  │
//   │  Alunos · Santos     "FINITUDES" preto.       │
//   │                      Pode sobrepor a aquarela.│
//   └───────────────────────────────────────────────┘
//
// A aquarela fica posicionada absolutamente à direita
// (entra ATRÁS do masthead com z-index 0 vs z-index 10).
// =============================================================
import WatercolorAccent from "./WatercolorAccent.astro";

export interface HeroContent {
  headline: string;
  href: string;
  edition?: string;
}

export interface Props {
  hero?: HeroContent;
}

const FAKE: HeroContent = {
  headline: "Gwendoline Riley's new novel surveys the wreckage of middle age",
  href: "/outras-historias/gwendoline-riley",
  edition: "Alunos · Santos",
};

const { hero = FAKE } = Astro.props;
---

<section class="relative">
  <div
    class="relative max-w-7xl mx-auto px-6 lg:px-12 pt-10 lg:pt-12 pb-16 lg:pb-20"
  >
    <div class="grid grid-cols-12 gap-6 items-start">
      {/* Coluna esquerda · headline + masthead horizontal */}
      <div class="col-span-12 lg:col-span-7 order-2 lg:order-1 relative z-10">
        {/* Headline pequena italic bordô — coluna curta */}
        <a
          href={hero.href}
          class="block group max-w-[15rem] lg:max-w-[16rem] lg:pl-12"
        >
          <p
            class="font-display italic text-rouge text-[18px] sm:text-[20px] lg:text-[22px] leading-[1.18] group-hover:text-rouge-deep transition-colors"
          >
            {hero.headline}
          </p>
        </a>

        {/* Masthead horizontal — "(IN)" red menor + "FINITUDES" preto grande */}
        <div class="mt-8 lg:mt-12">
          <h2
            class="font-display leading-[0.95] tracking-[-0.02em] font-medium flex items-baseline gap-0 whitespace-nowrap"
          >
            <span
              class="text-rouge text-[34px] sm:text-[48px] lg:text-[60px] xl:text-[70px]"
            >
              (IN)
            </span>
            <span
              class="text-ink text-[44px] sm:text-[64px] lg:text-[84px] xl:text-[100px]"
            >
              FINITUDES
            </span>
          </h2>
          {
            hero.edition && (
              <p class="mt-1 lg:mt-2 font-sans text-[10px] tracking-[0.34em] uppercase text-ink/70">
                {hero.edition}
              </p>
            )
          }
        </div>
      </div>

      {/* Coluna direita · aquarela */}
      <div
        class="col-span-12 lg:col-span-5 order-1 lg:order-2 flex justify-center lg:justify-end"
      >
        <WatercolorAccent
          variant="rouge-blob"
          loading="eager"
          class="w-[260px] sm:w-[340px] lg:w-[400px] xl:w-[440px] h-auto -mt-4 lg:-mt-8"
        />
      </div>
    </div>
  </div>
</section>
