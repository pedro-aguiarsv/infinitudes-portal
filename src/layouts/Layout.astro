---
// =============================================================
// Layout.astro · Shell base de todas as páginas
// As fontes oficiais (DIN Alternate Bold + Myriad Variable Concept)
// são carregadas via @font-face direto no global.css, a partir de
// /public/fonts/ — não usamos mais Google Fonts.
// =============================================================
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "(IN)Finitudes — Diva Infinito",
  description = "Ensaios, relatos e curadoria sobre humanização na saúde, cuidados paliativos e a arte de acompanhar.",
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Preload das fontes locais para evitar FOUT */}
    <link
      rel="preload"
      href="/fonts/din-alternate-bold.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/myriad-variable-concept.otf"
      as="font"
      type="font/otf"
      crossorigin
    />

    <title>{title}</title>
  </head>
  <body class="font-sans bg-paper text-ink">
    <slot />
  </body>
</html>
