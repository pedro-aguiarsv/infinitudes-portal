---
// =============================================================
// Layout.astro · Shell base de todas as páginas
// As fontes oficiais (DIN Alternate Bold + Myriad Variable Concept)
// são carregadas via @font-face direto no global.css, a partir de
// /public/fonts/ — não usamos mais Google Fonts.
// =============================================================
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "(In)finitudes — Divã Infinito",
  description = "Ensaios, relatos e curadoria sobre humanização na saúde, cuidados paliativos e a arte de acompanhar.",
  image = "/og-image.png",
} = Astro.props;

// URL canônica (resolve a imagem em URL absoluta para Open Graph)
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL(image, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL.toString()} />

    {/* Preload das fontes locais para evitar FOUT */}
    <link
      rel="preload"
      href="/fonts/din-alternate-bold.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/myriad-variable-concept.otf"
      as="font"
      type="font/otf"
      crossorigin
    />

    <title>{title}</title>

    {/* Open Graph · usado pelo WhatsApp, Facebook, LinkedIn etc. */}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="(In)finitudes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="(In)finitudes — capa do livro de Eleonora C. Santos" />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="font-sans bg-paper text-ink">
    <slot />
  </body>
</html>
