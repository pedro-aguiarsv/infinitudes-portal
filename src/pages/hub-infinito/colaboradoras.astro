---
// =============================================================
// /hub-infinito/colaboradoras · Roster completo "Quem faz o Hub?"
// -------------------------------------------------------------
// Página dedicada com todas as colaboradoras em ordem alfabética
// (primeiro nome). Retrato circular colorido + nome + função + bio.
// Acessada pela faixa-teaser (HubCollaboratorsStrip) na /hub-infinito.
// =============================================================
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CollaboratorAvatar from "../../components/CollaboratorAvatar.astro";
import { resolveCollaborators, collaboratorHref } from "../../lib/collaborators";

const items = await resolveCollaborators();
const featured = items.find((c) => c.featured);
const rest = items.filter((c) => !c.featured);
---

<Layout
  title="Quem faz o Hub Infinito? — (In)finitudes"
  description="As mulheres que escrevem, cuidam e pensam a finitude no Hub Infinito — um espaço de escrita exclusivo de mulheres."
>
  <Header />

  <main>
    {/* Cabeçalho */}
    <section class="max-w-5xl mx-auto px-6 lg:px-12">
      <header class="py-12 lg:py-16 text-center">
        <p class="eyebrow text-rouge">Colaboradoras</p>
        <h1
          class="font-display text-[36px] sm:text-[48px] lg:text-[58px] leading-[1.06] font-normal mt-3 tracking-[-0.01em]"
        >
          Quem faz o Hub Infinito?
        </h1>
        <p
          class="font-serif italic text-[18px] lg:text-[20px] text-ink/75 mt-4 max-w-2xl mx-auto"
        >
          Um espaço de escrita exclusivo de mulheres — vozes que escrevem,
          cuidam e pensam a finitude, cada uma a partir da sua área.
        </p>
        <a
          href="/hub-infinito"
          class="link-ed inline-block mt-6 font-sans text-[12px] font-medium tracking-[0.14em] uppercase text-ink/60 hover:text-rouge"
        >
          ← Voltar ao Hub Infinito
        </a>
      </header>
    </section>

    {/* Roster · duas colunas no desktop, filetes bordô no topo de cada linha */}
    <section class="max-w-5xl mx-auto px-6 lg:px-12 pb-16 lg:pb-24">
      {/* Destaque · coordenação — ocupa a largura toda */}
      {featured && (
        <a
          href={collaboratorHref(featured.slug)}
          class="group block pb-4 lg:pb-6"
        >
          <article class="flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-6 lg:gap-10">
            <CollaboratorAvatar collaborator={featured} size="xl" />
            <div class="min-w-0 flex-1">
              <h2 class="font-serif text-[22px] lg:text-[26px] leading-[1.15] tracking-[-0.005em] transition-colors group-hover:text-rouge">
                {featured.name}
              </h2>
              {featured.role && (
                <p class="font-sans text-[12px] font-medium tracking-[0.16em] uppercase text-rouge mt-2">
                  {featured.role}
                </p>
              )}
              <p class="font-serif text-[16px] lg:text-[18px] leading-[1.6] mt-4 text-ink/80 max-w-2xl">
                {featured.bio}
              </p>
              <span class="inline-block mt-4 font-sans text-[11px] font-medium tracking-[0.14em] uppercase text-rouge/0 group-hover:text-rouge transition-colors">
                Ver perfil →
              </span>
            </div>
          </article>
        </a>
      )}

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 lg:gap-x-16">
        {
          rest.map((c) => (
            <a
              href={collaboratorHref(c.slug)}
              class="group block border-t border-rouge-line/70"
            >
              <article class="flex gap-5 lg:gap-6 py-8">
                <CollaboratorAvatar collaborator={c} size="lg" />
                <div class="min-w-0">
                  <h2 class="font-serif text-[22px] lg:text-[26px] leading-[1.15] tracking-[-0.005em] transition-colors group-hover:text-rouge">
                    {c.name}
                  </h2>
                  {c.role && (
                    <p class="font-sans text-[11px] font-medium tracking-[0.18em] uppercase text-rouge mt-1.5">
                      {c.role}
                    </p>
                  )}
                  <p class="font-serif text-[15px] lg:text-[16px] leading-[1.55] mt-3 text-ink/80">
                    {c.bio}
                  </p>
                </div>
              </article>
            </a>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>
