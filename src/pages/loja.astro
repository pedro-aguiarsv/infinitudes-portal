---
// =============================================================
// /loja · Listagem de produtos (page-05)
// -------------------------------------------------------------
// Sobrescreve a rota dinâmica `[category].astro` para `/loja`.
// Estrutura:
//   1. Hero: aquarela vermelha + label "LOJA"
//   2. Divider rouge
//   3. Grid 3 colunas de ProductCard
//   4. Footer (sem newsletter — diferente das outras páginas)
//
// Catálogo vem do Sanity (schema `product`). Se vazio, cai em
// fallback mínimo (`FALLBACK_PRODUCTS`) para a página continuar
// funcionando.
// =============================================================
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProductCard from "../components/ProductCard.astro";
import WatercolorAccent from "../components/WatercolorAccent.astro";
import Divider from "../components/Divider.astro";
import { getAllProducts, urlFor } from "../lib/sanity";
import { FALLBACK_PRODUCTS, mapSanityProduct } from "../lib/products";

const sanityProducts = await getAllProducts();

const products =
  sanityProducts.length > 0
    ? sanityProducts.map((p) =>
        mapSanityProduct(
          p,
          p.mainImage
            ? urlFor(p.mainImage)
                .width(800)
                .height(800)
                .fit("crop")
                .auto("format")
                .url()
            : null,
        ),
      )
    : FALLBACK_PRODUCTS;
---

<Layout title="Loja — (In)finitudes" description="Livros, cadernos e objetos editoriais.">
  <Header />

  <main>
    {/* 1 · HERO · aquarela vermelha + label "LOJA" */}
    <section
      class="relative overflow-hidden max-w-6xl mx-auto px-6 lg:px-12 py-12 lg:py-20"
    >
      <WatercolorAccent
        variant="rouge-blob"
        class="absolute right-0 top-0 w-[55%] max-w-[640px] h-auto opacity-95 pointer-events-none"
      />
      <div class="relative z-10 min-h-[280px] lg:min-h-[360px] flex items-center">
        <h1
          class="font-display text-[52px] sm:text-[72px] lg:text-[88px] leading-[1] font-normal tracking-[-0.01em] text-ink"
        >
          LOJA
        </h1>
      </div>
    </section>

    {/* 2 · Divider rouge */}
    <div class="max-w-6xl mx-auto px-6 lg:px-12">
      <Divider variant="rouge" gap="my-4" />
    </div>

    {/* 3 · GRID */}
    <section class="max-w-6xl mx-auto px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-x-6 lg:gap-x-12 gap-y-14 lg:gap-y-20">
        {
          products.map((p) => (
            <ProductCard
              title={p.title}
              byline={p.byline}
              price={p.price}
              href={`/loja/${p.slug}`}
              bg={p.bg}
              imageUrl={p.imageUrl}
              imageAlt={p.imageAlt}
            />
          ))
        }
      </div>

      {sanityProducts.length === 0 && (
        <p class="meta text-center mt-12 text-muted/80">
          Catálogo em construção · novos produtos serão publicados em breve.
        </p>
      )}
    </section>
  </main>

  <Footer />
</Layout>
