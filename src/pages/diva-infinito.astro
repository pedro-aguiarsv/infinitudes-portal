---
// =============================================================
// /diva-infinito · Listagem do videocast (page-07)
// -------------------------------------------------------------
// Substitui a rota dinâmica `[category].astro` para `/diva-infinito`.
// Mostra episódios com aquarela + 2 CTAs.
// Lê o schema `episode` do Sanity. Se vazio, cai em fake editorial.
// =============================================================
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionTitle from "../components/SectionTitle.astro";
import EpisodeListItem from "../components/EpisodeListItem.astro";
import MakingOffItem from "../components/MakingOffItem.astro";
import NewsletterSection from "../components/NewsletterSection.astro";
import Divider from "../components/Divider.astro";
import { getCategoriesMerged } from "../lib/categories";
import { getAllEpisodes, urlFor } from "../lib/sanity";
import { getYouTubeId, getYouTubeThumbnail } from "../lib/embeds";

const [episodes, merged] = await Promise.all([
  getAllEpisodes(),
  getCategoriesMerged(),
]);

const category = merged.find((c) => c.value === "diva-infinito");

// Fallback editorial para o bloco "O que é?". Quando a Eleonora
// preencher `longDescription` no Sanity (documento de categoria
// "Divã Infinito"), esse texto é substituído automaticamente.
const FALLBACK_LONG_DESCRIPTION =
  "Um podcast que busca refletir sobre os efeitos dos processos de adoecimento na psique humana, na fé e na espiritualidade. Discute histórias e casos vividos por médicos e pacientes, teólogos e pessoas que adotam práticas espirituais como parte dos processos de tratamento e cura.";

const longDescription = category?.longDescription ?? FALLBACK_LONG_DESCRIPTION;

// Lista de "Temporadas" vem 100% do Sanity. Ordena do mais antigo
// (menor número) no topo para o mais novo embaixo.
const realTemporadas = episodes
  .filter((ep) => (ep.type ?? "temporada") === "temporada")
  .sort((a, b) => a.number - b.number);
const realMakingOff = episodes.filter((ep) => ep.type === "making-off");

// Helper para alternar a cor do bloco (rouge/black) por índice.
function withVariants<T>(items: T[]): (T & { variant: "rouge" | "black" })[] {
  return items.map((item, idx) => ({
    ...item,
    variant: (idx % 2 === 0 ? "rouge" : "black") as "rouge" | "black",
  }));
}

const temporadasList = withVariants(
  realTemporadas.map((ep) => {
    // Link direto pro YouTube só quando o vídeo é de fato do YouTube.
    const youtubeUrl = getYouTubeId(ep.videoUrl) ? (ep.videoUrl ?? null) : null;
    // Capa: prioriza a thumbnail cadastrada no Sanity; senão usa a capa
    // oficial do YouTube derivada da URL do vídeo.
    const thumbUrl = ep.thumbnail
      ? urlFor(ep.thumbnail).width(440).height(440).fit("crop").auto("format").url()
      : getYouTubeThumbnail(ep.videoUrl);
    return {
      number: ep.number,
      title: ep.title,
      description: ep.description,
      slug: ep.slug,
      thumbUrl,
      youtubeUrl,
    };
  }),
);

// Making-off · layout side-by-side (vídeo + texto). Quando ainda
// não há making-offs cadastrados no Sanity, renderiza dois cards
// placeholder com a estrutura final pra que a Eleonora visualize
// o layout antes de subir os vídeos. Substituir os textos abaixo
// pelos definitivos quando os arquivos forem enviados.
type MakingOffEntry = {
  number: number;
  title: string;
  description: string;
  videoUrl: string | null;
  poster: string | null;
  slug: string | null;
  orientation: "portrait" | "landscape";
};

const FAKE_MAKING_OFF: MakingOffEntry[] = [
  {
    number: 1,
    title: "Trailler · Divã Infinito",
    description:
      "Pequenos trechos dos 6 primeiros episódios do Divã Infinito.",
    videoUrl: "/videos/making-off-geral.mp4",
    poster: null,
    slug: null,
    orientation: "portrait",
  },
  {
    number: 2,
    title: "Trilha sonora · Divã Infinito",
    description:
      "Trilha sonora composta pelo Padre Luiz Eustáquio Nogueira para o podcast Divã Infinito.",
    videoUrl: "/videos/making-off-trilha.mp4",
    poster: null,
    slug: null,
    orientation: "portrait",
  },
];

// Detecta Shorts do YouTube (vídeo vertical) para usar proporção 9:16;
// demais vídeos seguem em 16:9.
function detectOrientation(url: string | null): "portrait" | "landscape" {
  return url && /\/shorts\//.test(url) ? "portrait" : "landscape";
}

const makingOffList: MakingOffEntry[] =
  realMakingOff.length > 0
    ? realMakingOff.map((ep) => ({
        number: ep.number,
        title: ep.title,
        description: ep.description,
        videoUrl: ep.videoUrl ?? null,
        poster: null,
        slug: ep.slug,
        orientation: detectOrientation(ep.videoUrl ?? null),
      }))
    : FAKE_MAKING_OFF;
---

<Layout
  title="Divã Infinito — (In)finitudes"
  description="Conversas em torno dos episódios do podcast."
>
  <Header />

  <main>
    <section class="max-w-5xl mx-auto px-6 lg:px-12">
      <SectionTitle eyebrow="Podcast" title="Divã Infinito" />
    </section>

    {/* O que é? */}
    <section class="bg-paper-soft border-y border-rule/60">
      <div class="max-w-3xl mx-auto px-6 py-14 lg:py-20 text-center">
        <p class="eyebrow text-rouge">O que é?</p>
        <p
          class="font-serif text-[18px] lg:text-[20px] leading-[1.6] mt-5 text-ink-soft"
        >
          {longDescription}
        </p>
      </div>
    </section>

    <section class="max-w-5xl mx-auto px-6 lg:px-12 pt-16 lg:pt-20 pb-16 lg:pb-24">
      {/* Tabs: Temporadas | Making-off */}
      <div
        class="diva-tabs flex justify-center gap-8 lg:gap-12 border-b border-rule/60 pb-1 mb-10"
        role="tablist"
        aria-label="Tipo de episódio"
      >
        <button
          type="button"
          role="tab"
          id="tab-temporadas"
          aria-controls="panel-temporadas"
          aria-selected="true"
          data-diva-tab="temporadas"
          class="diva-tab is-active"
        >
          Temporadas
          {temporadasList.length > 0 && (
            <span class="diva-tab-count">({temporadasList.length})</span>
          )}
        </button>
        <button
          type="button"
          role="tab"
          id="tab-making-off"
          aria-controls="panel-making-off"
          aria-selected="false"
          data-diva-tab="making-off"
          class="diva-tab"
        >
          Making-off
          {makingOffList.length > 0 && (
            <span class="diva-tab-count">({makingOffList.length})</span>
          )}
        </button>
      </div>

      {/* Painel: Temporadas */}
      <div
        id="panel-temporadas"
        role="tabpanel"
        aria-labelledby="tab-temporadas"
        data-diva-panel="temporadas"
      >
        {
          temporadasList.length > 0 && (
            <>
              <Divider variant="rouge" />
              {temporadasList.map((ep, idx) => (
                <>
                  <EpisodeListItem
                    number={ep.number}
                    title={ep.title}
                    description={ep.description}
                    href={`/diva-infinito/${ep.slug}`}
                    variant={ep.variant}
                    showAllLink={idx > 0}
                    thumbUrl={ep.thumbUrl}
                    youtubeUrl={ep.youtubeUrl}
                  />
                  <Divider variant="rule" />
                </>
              ))}
            </>
          )
        }
      </div>

      {/* Painel: Making-off · layout side-by-side (vídeo + texto) */}
      <div
        id="panel-making-off"
        role="tabpanel"
        aria-labelledby="tab-making-off"
        data-diva-panel="making-off"
        hidden
      >
        <Divider variant="rouge" />
        {
          makingOffList.map((ep, idx) => (
            <>
              <MakingOffItem
                number={ep.number}
                title={ep.title}
                description={ep.description}
                videoUrl={ep.videoUrl}
                poster={ep.poster}
                href={ep.slug ? `/diva-infinito/${ep.slug}` : null}
                variant={idx % 2 === 0 ? "default" : "reverse"}
                orientation={ep.orientation}
              />
              <Divider variant="rule" />
            </>
          ))
        }
      </div>
    </section>

    <NewsletterSection />
  </main>

  <Footer />
</Layout>

<style>
  .diva-tab {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(var(--ink) / 0.55);
    padding: 0.5rem 0.25rem 0.75rem;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
    background: transparent;
    cursor: pointer;
  }

  .diva-tab:hover {
    color: rgb(var(--ink) / 0.85);
  }

  .diva-tab.is-active {
    color: rgb(var(--rouge));
    border-bottom-color: rgb(var(--rouge));
  }

  .diva-tab-count {
    margin-left: 0.4em;
    font-size: 10px;
    opacity: 0.6;
    letter-spacing: 0.18em;
  }

  .diva-tab:focus-visible {
    outline: 2px solid rgb(var(--rouge));
    outline-offset: 4px;
  }
</style>

<script>
  // Toggle entre as abas "Temporadas" e "Making-off".
  // Mantém o estado na URL (?aba=making-off) para que links externos
  // e atualização de página preservem a aba escolhida.
  (function initDivaTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>("[data-diva-tab]");
    const panels = document.querySelectorAll<HTMLElement>("[data-diva-panel]");

    if (tabs.length === 0) return;

    function activate(name: string, pushHistory = true) {
      tabs.forEach((t) => {
        const active = t.dataset.divaTab === name;
        t.classList.toggle("is-active", active);
        t.setAttribute("aria-selected", String(active));
        t.tabIndex = active ? 0 : -1;
      });
      panels.forEach((p) => {
        p.hidden = p.dataset.divaPanel !== name;
      });
      if (pushHistory) {
        const url = new URL(window.location.href);
        if (name === "temporadas") {
          url.searchParams.delete("aba");
        } else {
          url.searchParams.set("aba", name);
        }
        history.replaceState(null, "", url.toString());
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const name = tab.dataset.divaTab;
        if (name) activate(name);
      });
      tab.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        e.preventDefault();
        const arr = Array.from(tabs);
        const idx = arr.indexOf(tab);
        const next =
          e.key === "ArrowRight"
            ? arr[(idx + 1) % arr.length]
            : arr[(idx - 1 + arr.length) % arr.length];
        next.focus();
        const name = next.dataset.divaTab;
        if (name) activate(name);
      });
    });

    const initial = new URL(window.location.href).searchParams.get("aba");
    if (initial === "making-off") activate("making-off", false);
  })();
</script>
