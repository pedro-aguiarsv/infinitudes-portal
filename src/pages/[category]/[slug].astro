---
// =============================================================
// [category]/[slug].astro · Página de um post individual
// -------------------------------------------------------------
// URLs no formato /categoria/titulo-do-post (editorial + SEO).
// Renderiza um de dois layouts selecionado pelo campo
// `layoutVariant` do Sanity:
//
//   · "classic" (padrão) → page-10: cabeçalho centralizado +
//                          corpo em coluna única + Favoritos
//   · "cover"            → page-04: hero bordô full-width +
//                          corpo em 2 colunas (texto + aquarela
//                          decorativa) + Favoritos + Leia Mais
//
// Quando o campo não existe no Sanity, cai em "classic".
// =============================================================
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import NewsletterSection from "../../components/NewsletterSection.astro";
import PostHeaderClassic from "../../components/PostHeaderClassic.astro";
import PostHeaderCover from "../../components/PostHeaderCover.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import WatercolorAccent from "../../components/WatercolorAccent.astro";
import Divider from "../../components/Divider.astro";
import { PortableText } from "astro-portabletext";
import {
  getAllPosts,
  getPostBySlug,
  urlFor,
  type PostFull,
  type PostPreview,
} from "../../lib/sanity";
import { getCategory } from "../../lib/categories";
import PTBlock from "../../components/portable-text/PTBlock.astro";
import PTImage from "../../components/portable-text/PTImage.astro";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts
    .filter((p) => p.category)
    .map((post) => ({
      params: { category: post.category!, slug: post.slug },
    }));
}

const { slug } = Astro.params;
const post = (await getPostBySlug(slug!)) as PostFull | null;

if (!post) {
  return Astro.redirect("/404");
}

const category = post.category ? getCategory(post.category) : null;
const variant = post.layoutVariant ?? "classic";

const heroImage = post.mainImage
  ? urlFor(post.mainImage).width(1600).height(1067).fit("crop").auto("format").url()
  : null;

const formattedDate = post.publishedAt
  ? new Intl.DateTimeFormat("pt-BR", {
      day: "numeric",
      month: "long",
      year: "numeric",
    }).format(new Date(post.publishedAt))
  : null;

// Posts relacionados · pega os 8 mais recentes da mesma categoria
// (excluindo o atual). Cai em [] se não houver outros posts.
const allPosts = await getAllPosts();
const relatedPosts: PostPreview[] = allPosts
  .filter((p) => p._id !== post._id && p.category === post.category)
  .slice(0, 8);

const components = {
  type: { image: PTImage },
  block: {
    normal: PTBlock,
    h2: PTBlock,
    h3: PTBlock,
    blockquote: PTBlock,
  },
};
---

<Layout
  title={`${post.title} — (In)finitudes`}
  description={post.excerpt ?? undefined}
>
  <Header />

  <main>
    <article>
      {/* === HEADER · branch por variante === */}
      {
        variant === "cover" ? (
          <PostHeaderCover
            title={post.title}
            dek={post.excerpt}
            authors={post.authors ?? null}
            date={formattedDate}
            imageUrl={heroImage}
            imageAlt={post.mainImage?.alt}
          />
        ) : (
          <PostHeaderClassic
            eyebrow={category?.title ?? "Seção"}
            title={post.title}
            dek={post.excerpt}
            authors={post.authors ?? null}
            date={formattedDate}
          />
        )
      }

      {/* === IMAGEM DE ABERTURA · só na variant classic === */}
      {
        variant === "classic" && heroImage && (
          <figure class="max-w-4xl mx-auto px-6 mt-2">
            <img
              src={heroImage}
              alt={post.mainImage?.alt ?? post.title}
              class="w-full aspect-[3/2] object-cover"
              loading="eager"
              fetchpriority="high"
            />
            {post.mainImage?.alt && (
              <figcaption class="meta mt-3 text-center">
                {post.mainImage.alt}
              </figcaption>
            )}
          </figure>
        )
      }

      {/* === CORPO · layouts distintos === */}
      {
        variant === "cover" ? (
          <div class="max-w-6xl mx-auto px-6 lg:px-12 py-14 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
              {/* Texto à esquerda */}
              <div
                class="lg:col-span-6 font-serif text-[17px] lg:text-[18px] leading-[1.7] space-y-5 text-ink-soft"
              >
                <PortableText value={post.body} components={components} />
              </div>

              {/* Aquarela decorativa à direita */}
              <div class="lg:col-span-6 flex justify-center lg:justify-end">
                <WatercolorAccent
                  variant="black-blob"
                  class="w-[280px] sm:w-[380px] lg:w-[460px] h-auto sticky top-10"
                />
              </div>
            </div>
          </div>
        ) : (
          <div class="max-w-2xl mx-auto px-6 py-14 lg:py-20">
            <div
              class="font-serif text-[18px] lg:text-[19px] leading-[1.75] space-y-5 text-ink-soft"
            >
              <PortableText value={post.body} components={components} />
            </div>
          </div>
        )
      }

      {/* === FIM · linha divisória + link de retorno === */}
      <div class="max-w-2xl mx-auto px-6 pb-16 lg:pb-20 text-center">
        <Divider variant="rouge" gap="mb-10" />
        {
          category && (
            <a
              href={category.href}
              class="font-sans text-[11px] font-medium tracking-[0.22em] uppercase text-rouge link-ed"
            >
              ← Mais em {category.title}
            </a>
          )
        }
      </div>
    </article>

    {/* === LEIA MAIS · só na variant cover === */}
    {
      variant === "cover" && relatedPosts.length > 0 && (
        <RelatedPosts posts={relatedPosts} />
      )
    }

    {/* === NEWSLETTER === */}
    <NewsletterSection />
  </main>

  <Footer />
</Layout>
