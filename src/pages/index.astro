---
// =============================================================
// index.astro · Home do portal (IN)Finitudes (page-01)
// -------------------------------------------------------------
// Composição editorial:
//   1. Header
//   2. HeroFeatured        ← "capa de revista" com headline + masthead
//   3. FeaturedEssay       ← ensaio de capa com aquarela preta
//   4. Grid de 3 posts     ← Outras Histórias (faixa sem título)
//   5. BookSection         ← banner bordô do livro
//   6. LongEssayHighlight  ← ensaio longo com capitular
//   7. NewsletterSection   ← captura de e-mail
//   8. Footer
//
// Dados vêm do Sanity quando disponível; senão, cada componente
// usa fake data editorial coerente (estado "vazio apresentável").
// =============================================================
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroFeatured from "../components/HeroFeatured.astro";
import FeaturedEssay from "../components/FeaturedEssay.astro";
import PostCard from "../components/PostCard.astro";
import BookSection from "../components/BookSection.astro";
import LongEssayHighlight from "../components/LongEssayHighlight.astro";
import NewsletterSection from "../components/NewsletterSection.astro";
import { getAllPosts, type PostPreview } from "../lib/sanity";
import { getCategory } from "../lib/categories";

const posts = await getAllPosts();
const [featured, ...rest] = posts;
const gridPosts = rest.slice(0, 3);

// Hero · headline aponta para o post mais recente
const heroContent = featured
  ? {
      headline: featured.title,
      href: featured.category
        ? `/${featured.category}/${featured.slug}`
        : `/${featured.slug}`,
      edition: "Alunos · Santos",
    }
  : undefined;

// Ensaio de capa (segundo post mais recente ou featured se for único)
const featuredEssay = posts[1] ?? posts[0];
const essayContent = featuredEssay
  ? {
      eyebrow: `${getCategory(featuredEssay.category ?? "")?.title ?? "Ensaio"} · Cuidados Paliativos`,
      title: featuredEssay.title,
      dek: featuredEssay.excerpt,
      byline: null,
      readingTime: null,
      href: featuredEssay.category
        ? `/${featuredEssay.category}/${featuredEssay.slug}`
        : `/${featuredEssay.slug}`,
    }
  : undefined;

// Fake data para o grid de 3 posts (estado "vazio apresentável")
type FakeCard = {
  post: PostPreview;
  categoryLabel: string;
  author: string;
};

const FAKE_GRID: FakeCard[] = [
  {
    post: {
      _id: "fake-1",
      title: "O que aprendi ao cuidar da minha mãe nos últimos meses",
      slug: "cuidar-da-minha-mae",
      publishedAt: new Date().toISOString(),
      mainImage: null,
      category: "diva-infinito",
      excerpt:
        "Quando a cura deixa de ser o objetivo, descobrimos que presença é a forma mais honesta de amor.",
    },
    categoryLabel: "Divã Infinito",
    author: "Por Marina Pires",
  },
  {
    post: {
      _id: "fake-2",
      title: "Dor total: o que Cicely Saunders ainda tem a nos ensinar",
      slug: "dor-total-cicely-saunders",
      publishedAt: new Date().toISOString(),
      mainImage: null,
      category: "hub-infinito",
      excerpt:
        "Conversa com a enfermeira e pesquisadora Ana Lúcia Freire sobre o conceito que fundou o movimento hospice moderno.",
    },
    categoryLabel: "Hub Infinito",
    author: "Por Eleonora Cruz Santos",
  },
  {
    post: {
      _id: "fake-3",
      title: "Cartas de uma enfermeira de cuidado intensivo",
      slug: "cartas-de-hospice",
      publishedAt: new Date().toISOString(),
      mainImage: null,
      category: "curadoria",
      excerpt:
        "Cinco documentos resgatados que revelam como o cuidado ao fim da vida mudou — e o que permanece intacto.",
    },
    categoryLabel: "Curadoria",
    author: "Por Eleonora Cruz Santos",
  },
];

const hasRealPosts = gridPosts.length > 0;
---

<Layout title="(IN)Finitudes — Divã Infinito">
  <Header />

  <main>
    {/* 1 · Capa de revista · headline + masthead + aquarela vermelha */}
    <HeroFeatured hero={heroContent} />

    {/* 2 · Ensaio de capa · aquarela preta + título + dek */}
    <FeaturedEssay essay={essayContent} />

    {/* 3 · Grid de 3 posts · sem título de seção (faixa direta) */}
    <section class="max-w-6xl mx-auto px-6 lg:px-12 py-16 lg:py-24">
      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-y-14 md:gap-x-10 lg:gap-x-14"
      >
        {
          hasRealPosts
            ? gridPosts.map((post) => <PostCard post={post} />)
            : FAKE_GRID.map((item) => (
                <PostCard
                  post={item.post}
                  category={item.categoryLabel}
                  author={item.author}
                />
              ))
        }
      </div>
    </section>

    {/* 4 · Banner bordô · livro */}
    <BookSection />

    {/* 5 · Ensaio longo destacado · capitular */}
    <LongEssayHighlight />

    {/* 6 · Newsletter */}
    <NewsletterSection />
  </main>

  <Footer />
</Layout>
