---
// =============================================================
// index.astro · Home do portal (In)finitudes (page-01)
// -------------------------------------------------------------
// Composição editorial:
//   1. Header
//   2. HeroFeatured        ← "capa de revista" com masthead + assinatura
//   3. FeaturedEssay       ← vitrine de HUB INFINITO (com aquarela preta)
//   4. Grid de 3 posts     ← faixa direta sem título de seção
//   5. BookSection         ← banner bordô do livro
//   6. LongEssayHighlight  ← vitrine de RECOMENDAMOS (capitular + CTA)
//   7. NewsletterSection   ← captura de e-mail
//   8. Footer
//
// Cada bloco tenta primeiro um post real da sua categoria-alvo no
// Sanity; se não houver, cai em fake data editorial coerente
// (estado "vazio apresentável").
// =============================================================
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroFeatured from "../components/HeroFeatured.astro";
import FeaturedEssay from "../components/FeaturedEssay.astro";
import PostCard from "../components/PostCard.astro";
import BookSection from "../components/BookSection.astro";
import LongEssayHighlight from "../components/LongEssayHighlight.astro";
import NewsletterSection from "../components/NewsletterSection.astro";
import { getAllPosts, type PostPreview } from "../lib/sanity";
import { getCategory } from "../lib/categories";
import { resolveExternalThumb } from "../lib/recommend-thumbs";

const posts = await getAllPosts();
const gridPostsRaw = posts.slice(0, 3);

// Resolve thumb externa (YouTube/Spotify) para posts do grid sem mainImage —
// mesmo padrão do /recomenda. Posts com mainImage cadastrada continuam
// tendo prioridade.
const gridPosts = await Promise.all(
  gridPostsRaw.map(async (p) => ({
    post: p,
    externalImageUrl: p.mainImage
      ? null
      : await resolveExternalThumb(p.externalUrl),
  })),
);

// Hero · masthead + assinatura institucional fixa
const heroContent = {
  manifesto:
    "O infinito faz parte da discussão do projeto, que vai da finitude da vida à infinitude das relações, dos laços e das formas de se ver e de se colocar na vida.",
  edition: "Projeto cultural idealizado por Eleonora Santos",
};

// FeaturedEssay (bloco "artigo de capa") · vitrine de HUB INFINITO
// Procura o post mais recente da categoria hub-infinito; se não houver,
// cai no FAKE do próprio componente (que já é Hub Infinito coerente).
const hubFeatured = posts.find((p) => p.category === "hub-infinito");
const essayContent = hubFeatured
  ? {
      eyebrow: getCategory(hubFeatured.category ?? "")?.title ?? "Hub Infinito",
      title: hubFeatured.title,
      dek: hubFeatured.excerpt,
      byline: null,
      readingTime: null,
      href: `/hub-infinito/${hubFeatured.slug}`,
    }
  : undefined;

// LongEssayHighlight (bloco de destaque editorial) · vitrine de
// RECOMENDAMOS. Procura o post mais recente da categoria recomenda;
// se não houver, cai no FAKE default do componente.
const reccFeatured = posts.find((p) => p.category === "recomenda");
const longEssayContent = reccFeatured
  ? {
      eyebrow:
        getCategory(reccFeatured.category ?? "")?.title ?? "Recomendamos",
      title: reccFeatured.title,
      paragraphs: reccFeatured.excerpt ? [reccFeatured.excerpt] : undefined,
      href: `/recomenda/${reccFeatured.slug}`,
    }
  : undefined;

// Fake data para o grid de 3 posts (estado "vazio apresentável")
type FakeCard = {
  post: PostPreview;
  categoryLabel: string;
  author: string;
};

const FAKE_GRID: FakeCard[] = [
  {
    post: {
      _id: "fake-1",
      title: "O que aprendi ao cuidar da minha mãe nos últimos meses",
      slug: "cuidar-da-minha-mae",
      publishedAt: new Date().toISOString(),
      mainImage: null,
      category: "diva-infinito",
      excerpt:
        "Quando a cura deixa de ser o objetivo, descobrimos que presença é a forma mais honesta de amor.",
    },
    categoryLabel: "Divã Infinito",
    author: "Por Marina Pires",
  },
  {
    post: {
      _id: "fake-2",
      title: "Dor total: o que Cicely Saunders ainda tem a nos ensinar",
      slug: "dor-total-cicely-saunders",
      publishedAt: new Date().toISOString(),
      mainImage: null,
      category: "hub-infinito",
      excerpt:
        "Conversa com a enfermeira e pesquisadora Ana Lúcia Freire sobre o conceito que fundou o movimento hospice moderno.",
    },
    categoryLabel: "Hub Infinito",
    author: "Por Eleonora Cruz Santos",
  },
  {
    post: {
      _id: "fake-3",
      title: "Cartas de uma enfermeira de cuidado intensivo",
      slug: "cartas-de-hospice",
      publishedAt: new Date().toISOString(),
      mainImage: null,
      category: "curadoria",
      excerpt:
        "Cinco documentos resgatados que revelam como o cuidado ao fim da vida mudou — e o que permanece intacto.",
    },
    categoryLabel: "Curadoria",
    author: "Por Eleonora Cruz Santos",
  },
];

const hasRealPosts = gridPosts.length > 0;
---

<Layout title="(In)finitudes — Divã Infinito">
  <Header />

  <main>
    {/* 1 · Capa de revista · manifesto editorial + aquarela vermelha */}
    <HeroFeatured hero={heroContent} />

    {/* Divisor fino entre o manifesto superior e o artigo de capa */}
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="border-t border-rule"></div>
    </div>

    {/* 2 · Artigo de capa · texto à esquerda + aquarela preta à direita */}
    <FeaturedEssay essay={essayContent} />

    {/* Divisor de seção · eyebrow centralizado entre linhas finas */}
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="flex items-center gap-6 py-10 lg:py-14">
        <span class="flex-1 h-px bg-rule"></span>
        <span class="eyebrow whitespace-nowrap">
          Relatos &amp; Podcasts da semana
        </span>
        <span class="flex-1 h-px bg-rule"></span>
      </div>
    </div>

    {/* 3 · Grid de 3 posts · alinhado ao container editorial */}
    <section class="max-w-7xl mx-auto px-6 lg:px-12 pb-16 lg:pb-24">
      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-y-14 md:gap-x-10 lg:gap-x-14"
      >
        {
          hasRealPosts
            ? gridPosts.map(({ post, externalImageUrl }) => (
                <PostCard
                  post={post}
                  externalImageUrl={externalImageUrl}
                />
              ))
            : FAKE_GRID.map((item) => (
                <PostCard
                  post={item.post}
                  category={item.categoryLabel}
                  author={item.author}
                />
              ))
        }
      </div>
    </section>

    {/* 4 · Banner bordô · livro (break section full-width intencional) */}
    <BookSection />

    {/* 5 · Vitrine de Recomendamos · destaque editorial com capitular */}
    <LongEssayHighlight {...(longEssayContent ?? {})} />

    {/* 6 · Newsletter */}
    <NewsletterSection />
  </main>

  <Footer />
</Layout>
