---
// =============================================================
// index.astro · Home do portal (In)finitudes (page-01)
// -------------------------------------------------------------
// Composição editorial:
//   1. Header
//   2. HeroFeatured            ← "capa de revista" com masthead + assinatura
//   3. FeaturedEssay           ← vitrine de HUB INFINITO (com aquarela preta)
//   4. Grid de 3 posts         ← faixa direta sem título de seção
//   5. BookSection             ← banner bordô do livro
//   6. Grid "Recomendamos"     ← 3 últimas publicações da categoria
//   7. NewsletterSection       ← captura de e-mail
//   8. Footer
//
// Cada bloco tenta primeiro um post real da sua categoria-alvo no
// Sanity; se não houver, cai em fake data editorial coerente
// (estado "vazio apresentável").
// =============================================================
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroFeatured from "../components/HeroFeatured.astro";
import PostCard from "../components/PostCard.astro";
import BookSection from "../components/BookSection.astro";
import NewsletterSection from "../components/NewsletterSection.astro";
import { getAllPosts } from "../lib/sanity";
import { resolveExternalThumb } from "../lib/recommend-thumbs";

const posts = await getAllPosts();

// Grid superior · "Em Alta & Podcasts da semana"
// Vitrine editorial fixa (curadoria manual) com três destaques:
//   1. Estreia do podcast Divã Infinito (interno, /diva-infinito).
//   2. Conversa em vídeo no Bucket List PodCast (externo, YouTube).
//   3. Coluna "As infinitas vozes de Eleonora Santos" (externo, BHAZ).
// Os cards são renderizados inline (não vêm do Sanity) — quando esses
// destaques mudarem, ajustar o markup no bloco "3 · Grid editorial".
type FeaturedCard = {
  href: string;
  external: boolean;
  eyebrow: string;
  title: string;
  excerpt: string;
  meta: string;
  /** Quando `image` é uma URL, usa-se como `<img>`. Quando é `null`, o card
   *  cai no placeholder visual (aquarela + logo) controlado pela `variant`. */
  image: string | null;
  imageAlt: string;
  /** Classe Tailwind opcional de object-position (ex.: "object-[center_20%]")
   *  para ajustar o enquadramento da imagem no recorte 4:3. */
  imagePosition?: string;
  /** Quando true, a imagem é exibida inteira (object-contain) sobre um fundo
   *  creme, em vez de preencher o card cortando (object-cover). Útil para
   *  artes verticais que perderiam o título/marca no recorte. */
  imageContain?: boolean;
  /** Variante do placeholder (rouge/black) — só usada quando `image === null`. */
  variant: "rouge" | "black";
};

const featuredCards: FeaturedCard[] = [
  {
    href: "/diva-infinito",
    external: false,
    eyebrow: "Divã Infinito",
    title: "Episódio 1 — estreia em junho",
    excerpt:
      "Estreia do podcast Divã Infinito. Disponível no YouTube e no Spotify a partir de 23 de junho.",
    meta: "Divã Infinito",
    image: "/diva-infinito/capa-episodio-1.webp",
    imageAlt: "(In)finitudes — Divã Infinito",
    variant: "rouge",
  },
  {
    href: "https://www.youtube.com/watch?v=cy-jyQ3kpDw",
    external: true,
    eyebrow: "Em alta",
    title: "Eleonora Santos no Bucket List PodCast",
    excerpt:
      "Conversa de pouco mais de uma hora com Gustavo Ziller (Grupo Zelo) sobre o “vai dar tudo certo”, finitude, espiritualidade e o projeto.",
    meta: "Bucket List PodCast · 1h07min",
    image: "https://i.ytimg.com/vi/cy-jyQ3kpDw/hqdefault.jpg",
    imageAlt: "Eleonora Santos no Bucket List PodCast",
    variant: "rouge",
  },
  {
    href: "https://bhaz.com.br/colunas/siga-essa-mulher/as-infinitas-vozes-de-eleonora-santos/",
    external: true,
    eyebrow: "Em alta",
    title: "As infinitas vozes de Eleonora Santos",
    excerpt:
      "Coluna sobre as decisões editoriais mais honestas do livro (In)finitudes — a recusa da “superação obrigatória” e as 20 vozes que atravessam a obra.",
    meta: "BHAZ · Coluna “Siga essa mulher” · Nalu Saad",
    image: "/authors/eleonora-bhaz.webp",
    imageAlt: "As infinitas vozes de Eleonora Santos — coluna na BHAZ",
    imageContain: true,
    variant: "black",
  },
];

// Hero · masthead + assinatura institucional fixa
const heroContent = {
  manifesto:
    "O infinito faz parte da discussão do projeto, que vai da finitude da vida à infinitude das relações, dos laços e das formas de se ver e de se colocar na vida, da possibilidade de se construir pontes de acolhimento e aconchego em meio às incertezas.",
  edition: "Projeto cultural idealizado por Eleonora Santos",
};

// Fragmento de capa · "Deus, a morte e a infinitude" — texto integral
// exibido no bloco de capa da home (sem link para página dedicada).
const fragmentoParagraphs = [
  "Quantos de nós somos realmente capazes de nos sentir acolhidos por Deus quando vivemos a morte de uma pessoa muito amada?",
  "Quantos de nós vivemos muito mais o clamor da piedade para estancar a dor do que a confiança de que Deus está realmente nos acolhendo?",
  "Quando nos sentimos realmente amados em meio a profundas dores e sentimentos de desamparo? Dores viscerais de desamparo e abandono, dores cobertas de medo e desproteção, dores da alma, dores…",
  "Nem sempre a dor vem como resultado de um ato concreto; ela pode ser fruto do intangível, da história não contada de um ambiente silenciado. Sua origem, talvez pouco importe, mas sua permanência, importa muito.",
  "A escuta é o passo para o acolhimento. A escuta interior é o maior passo para a superação. É o olhar para dentro, o escutar das batidas do coração embaladas por notas de presença divina - o refúgio mais certo.",
  "Na dicotomia da escuta, a dor ocupa os espaços do vazio interior, mas o esvaziamento interior preenche e aquece, constrói a ponte do amor acalentador.",
  "A dor da morte questiona a presença de Deus, ocupa o corpo e a mente, traz novo sentido ao existir, em especial ao existir que não mais existe.",
  "E onde está Deus? Está ali onde aparenta nada mais existir. Ocupa todo o vazio infinito, reconstitui o propósito e produz mudança pelo sentido. Onde está o inalcançável, o infinito, Deus lá está a nos esperar.",
];

// Vitrine "Recomendamos" · grid das 3 últimas publicações da
// categoria recomenda (mesmo layout do grid de 3 posts acima).
// Se a categoria estiver vazia no Sanity, o bloco simplesmente
// não é renderizado (sem fake) — o grid superior já cobre a vitrine.
const recommendationsRaw = posts
  .filter((p) => p.category === "recomenda")
  .slice(0, 3);

const recommendationCards = await Promise.all(
  recommendationsRaw.map(async (p) => ({
    post: p,
    externalImageUrl: p.mainImage
      ? null
      : await resolveExternalThumb(p.externalUrl),
  })),
);

---

<Layout
  title="(In)finitudes"
  description="Projeto cultural idealizado por Eleonora Santos: vozes reais sobre adoecimento, finitude e os laços que nos sustentam. Escuta, cuidado e a arte de acompanhar — da finitude da vida à infinitude das relações."
>
  <Header />

  <main>
    {/* 1 · Capa de revista · manifesto editorial + aquarela vermelha */}
    <HeroFeatured hero={heroContent} />

    {/* Divisor fino entre o manifesto superior e o artigo de capa */}
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="border-t border-rule"></div>
    </div>

    {/* 2 · Fragmento de capa · aquarela preta à esquerda + texto integral
         à direita (sem link — o texto completo vive aqui na home). */}
    <section>
      <div class="max-w-7xl mx-auto px-6 lg:px-12 py-20 lg:py-28">
        <div
          class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start"
        >
          {/* Coluna esquerda · aquarela preta (peça gráfica, fixa ao rolar) */}
          <div
            class="lg:col-span-5 flex justify-center lg:justify-start lg:sticky lg:top-28 self-start lg:-mt-10"
          >
            <img
              src="/watercolors/black-figure.webp"
              alt=""
              role="presentation"
              aria-hidden="true"
              loading="lazy"
              decoding="async"
              class="pointer-events-none select-none w-[320px] sm:w-[400px] lg:w-[440px] h-auto"
            />
          </div>

          {/* Coluna direita · eyebrow + título + autora + texto integral */}
          <div class="lg:col-span-7">
            <p class="eyebrow">Fragmentos</p>
            <h2
              class="font-serif text-[23px] sm:text-[27px] lg:text-[33px] leading-[1.12] mt-4 font-normal tracking-[-0.01em]"
            >
              Deus, a morte e a infinitude
            </h2>
            <p class="meta mt-2">Eleonora Santos</p>

            <div
              class="font-serif text-[13px] lg:text-[14px] leading-[1.65] mt-6 space-y-4 text-ink-soft"
            >
              {fragmentoParagraphs.map((p) => <p>{p}</p>)}
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Divisor de seção · eyebrow centralizado entre linhas finas */}
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="flex items-center gap-6 py-10 lg:py-14">
        <span class="flex-1 h-px bg-rule"></span>
        <span class="eyebrow whitespace-nowrap">
          Em Alta & Podcasts da semana
        </span>
        <span class="flex-1 h-px bg-rule"></span>
      </div>
    </div>

    {/* 3 · Grid editorial · três destaques fixos com mesma estrutura visual
         do PostCard (imagem 4:3 → eyebrow → título → excerpt → meta). Cards
         externos abrem em nova aba; cards sem imagem caem no placeholder
         de aquarela + logo. */}
    <section class="max-w-7xl mx-auto px-6 lg:px-12 pb-16 lg:pb-24">
      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-y-14 md:gap-x-10 lg:gap-x-14"
      >
        {
          featuredCards.map((card) => (
            <article class="group">
              <a
                href={card.href}
                {...(card.external
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
                class="block"
              >
                {card.image ? (
                  card.imageContain ? (
                    <div class="w-full aspect-[4/3] bg-paper-soft overflow-hidden flex items-center justify-center">
                      <img
                        src={card.image}
                        alt={card.imageAlt}
                        class="max-h-full max-w-full object-contain transition-[filter] duration-300 group-hover:brightness-95"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  ) : (
                    <img
                      src={card.image}
                      alt={card.imageAlt}
                      class={`w-full aspect-[4/3] object-cover ${card.imagePosition ?? ""} transition-[filter] duration-300 group-hover:brightness-95`}
                      loading="lazy"
                      decoding="async"
                    />
                  )
                ) : (
                  <div class="relative w-full aspect-[4/3] overflow-hidden bg-paper-soft">
                    <img
                      src={
                        card.variant === "rouge"
                          ? "/watercolors/rouge-blob.webp"
                          : "/watercolors/black-blob.webp"
                      }
                      alt=""
                      role="presentation"
                      aria-hidden="true"
                      loading="lazy"
                      decoding="async"
                      class="pointer-events-none select-none absolute inset-0 w-full h-full object-cover transition-[filter] duration-300 group-hover:brightness-95"
                    />
                    <div class="absolute inset-0 flex items-center justify-center p-8">
                      <picture>
                        <source
                          srcset="/logo/logo-mini.webp"
                          type="image/webp"
                        />
                        <img
                          src="/logo/logo-mini.png"
                          alt={card.imageAlt}
                          loading="lazy"
                          decoding="async"
                          class="select-none w-[42%] h-auto"
                          draggable="false"
                        />
                      </picture>
                    </div>
                  </div>
                )}

                <span class="eyebrow mt-5 block">{card.eyebrow}</span>

                <h3 class="font-serif text-[20px] lg:text-[22px] leading-[1.18] mt-2 font-medium tracking-[-0.005em] transition-colors group-hover:text-rouge">
                  {card.title}
                  {card.external && (
                    <span class="ml-1 align-middle" aria-hidden="true">
                      ↗
                    </span>
                  )}
                </h3>

                <p class="font-serif text-[15px] lg:text-[16px] leading-[1.45] mt-3 text-ink/80">
                  {card.excerpt}
                </p>

                <div class="meta mt-2">{card.meta}</div>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    {/* 4 · Banner bordô · livro (break section full-width intencional) */}
    <BookSection />

    {/* 5 · Vitrine de Recomendamos · grid das 3 últimas publicações */}
    {
      recommendationCards.length > 0 && (
        <>
          <div class="max-w-7xl mx-auto px-6 lg:px-12">
            <div class="flex items-center gap-6 py-10 lg:py-14">
              <span class="flex-1 h-px bg-rule" />
              <span class="eyebrow whitespace-nowrap">Recomenda</span>
              <span class="flex-1 h-px bg-rule" />
            </div>
          </div>
          <section class="max-w-7xl mx-auto px-6 lg:px-12 pb-16 lg:pb-24">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-y-14 md:gap-x-10 lg:gap-x-14">
              {recommendationCards.map(({ post, externalImageUrl }) => (
                <PostCard
                  post={post}
                  externalImageUrl={externalImageUrl}
                />
              ))}
            </div>
          </section>
        </>
      )
    }

    {/* 6 · Newsletter */}
    <NewsletterSection />
  </main>

  <Footer />
</Layout>
