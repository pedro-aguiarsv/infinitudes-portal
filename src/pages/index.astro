---
// =============================================================
// index.astro · Home do portal (In)finitudes (page-01)
// -------------------------------------------------------------
// Composição editorial:
//   1. Header
//   2. HeroFeatured            ← "capa de revista" com masthead + assinatura
//   3. Grid de 9 posts         ← Hub, Curadoria, Divã, Na Mídia e Recomenda
//   4. BookSection             ← banner bordô do livro
//   5. Grid "Recomendamos"     ← 3 últimas publicações da categoria
//   6. NewsletterSection       ← captura de e-mail
//   7. Footer
//
// Cada bloco tenta primeiro um post real da sua categoria-alvo no
// Sanity; se não houver, cai em fake data editorial coerente
// (estado "vazio apresentável").
// =============================================================
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroFeatured from "../components/HeroFeatured.astro";
import PostCard from "../components/PostCard.astro";
import BookSection from "../components/BookSection.astro";
import NewsletterSection from "../components/NewsletterSection.astro";
import { getAllPosts, urlFor, type PostPreview } from "../lib/sanity";
import { resolveExternalThumb } from "../lib/recommend-thumbs";
import { CATEGORIES } from "../lib/categories";

const posts = await getAllPosts();

// Grid superior · três linhas de três cards.
//   1. Hub Infinito — os três artigos mais recentes.
//   2. Na Mídia — os dois mais recentes e a coluna fixa da BHAZ.
//   3. Divã (canal) · Curadoria mais recente · Voto de Júbilo fixo.
type FeaturedCard = {
  href: string;
  external: boolean;
  eyebrow: string;
  title: string;
  excerpt: string;
  meta: string;
  /** Quando `image` é uma URL, usa-se como `<img>`. Quando é `null`, o card
   *  cai no placeholder visual (aquarela + logo) controlado pela `variant`. */
  image: string | null;
  imageAlt: string;
  /** Classe Tailwind opcional de object-position (ex.: "object-[center_20%]")
   *  para ajustar o enquadramento da imagem no recorte 4:3. */
  imagePosition?: string;
  /** Quando true, a imagem é exibida inteira (object-contain) sobre um fundo
   *  creme, em vez de preencher o card cortando (object-cover). Útil para
   *  artes verticais que perderiam o título/marca no recorte. */
  imageContain?: boolean;
  /** Variante do placeholder (rouge/black) — só usada quando `image === null`. */
  variant: "rouge" | "black";
};

const youtubeChannelCard: FeaturedCard = {
  href: "https://www.youtube.com/@projetoinfinitudes",
  external: true,
  eyebrow: "Divã Infinito",
  title: "Assista ao Divã Infinito no YouTube",
  excerpt:
    "Conversas de Eleonora Santos com convidados sobre fé, cuidado, finitude e o sentido do infinito — todos os episódios no canal do projeto.",
  meta: "YouTube · @projetoinfinitudes",
  image: "/diva-infinito/equipe-canal.webp",
  imageAlt:
    "Equipe do Divã Infinito reunida na gravação, ao lado do banner (In)finitudes",
  imagePosition: "object-[center_35%]",
  variant: "rouge",
};

// Capas locais quando o post não tem mainImage (Na Mídia / Recomenda).
const HOME_THUMBS: Record<
  string,
  { url: string; position?: "top" | "center" | "bottom" }
> = {
  "lancamento-infinitudes-palacio-das-artes": {
    url: "/recomenda-thumbs/lancamento-palacio-das-artes.webp",
    position: "top",
  },
  "jornada-de-um-paciente-oncologico-drauziocast-265": {
    url: "/recomenda-thumbs/jornada-de-um-paciente-oncologico-drauziocast-265.webp",
  },
  "midia-linkedin-lancamento-palacio-das-artes": {
    url: "/na-midia-thumbs/linkedin-lancamento.webp",
    position: "top",
  },
  "midia-revista-encontro-infinitudes": {
    url: "/na-midia-thumbs/revista-encontro.jpg",
  },
  "midia-fcs-lancamento-palacio-das-artes": {
    url: "/na-midia-thumbs/fcs-lancamento.png",
  },
  "midia-instagram-ana-alvarez-lancamento": {
    url: "/na-midia-thumbs/instagram-ana-alvarez.jpg",
    position: "top",
  },
  "midia-instagram-voto-de-jubilo-cmsp": {
    url: "/na-midia-thumbs/instagram-voto-de-jubilo.jpg",
  },
};

const HOME_OBJECT_POSITION: Record<string, string> = {
  top: "object-top",
  center: "object-center",
  bottom: "object-bottom",
};

async function publicationCard(
  post: PostPreview,
  eyebrow: string,
): Promise<FeaturedCard> {
  const cat = CATEGORIES.find((c) => c.value === post.category);
  const local = HOME_THUMBS[post.slug];
  const image =
    post.mainImage
      ? urlFor(post.mainImage).width(800).height(600).fit("crop").auto("format").url()
      : (post.coverUrl ??
        local?.url ??
        (await resolveExternalThumb(post.externalUrl)));
  const hasExternal = Boolean(post.externalUrl);
  const formattedDate = post.publishedAt
    ? new Intl.DateTimeFormat("pt-BR", {
        day: "numeric",
        month: "short",
        year: "numeric",
      }).format(new Date(post.publishedAt))
    : null;
  const metaParts = [post.authors?.trim() || cat?.title, formattedDate].filter(
    Boolean,
  );

  return {
    href: hasExternal ? post.externalUrl! : `${cat?.href ?? ""}/${post.slug}`,
    external: hasExternal,
    eyebrow,
    title: post.title,
    excerpt: post.excerpt ?? "",
    meta: metaParts.join(" · "),
    image,
    imageAlt: post.title,
    imagePosition: local?.position
      ? HOME_OBJECT_POSITION[local.position]
      : undefined,
    variant: "rouge",
  };
}

function takeLatest(
  category: string,
  count: number,
  skipSlugs: Set<string> = new Set(),
): PostPreview[] {
  const picked: PostPreview[] = [];
  for (const post of posts) {
    if (post.category !== category || skipSlugs.has(post.slug)) continue;
    picked.push(post);
    if (picked.length === count) break;
  }
  return picked;
}

const hubPosts = takeLatest("hub-infinito", 3);
const naMidiaPosts = takeLatest(
  "na-midia",
  2,
  new Set(["midia-instagram-voto-de-jubilo-cmsp"]),
);
const curadoriaPosts = takeLatest("curadoria", 1);

const bhazCard: FeaturedCard = {
  href: "https://bhaz.com.br/colunas/siga-essa-mulher/as-infinitas-vozes-de-eleonora-santos/",
  external: true,
  eyebrow: "Na Mídia",
  title: "As infinitas vozes de Eleonora Santos",
  excerpt:
    "Coluna sobre as decisões editoriais mais honestas do livro (In)finitudes — a recusa da “superação obrigatória” e as 20 vozes que atravessam a obra.",
  meta: "BHAZ · Coluna “Siga essa mulher” · Nalu Saad",
  image: "/authors/eleonora-bhaz.webp",
  imageAlt: "As infinitas vozes de Eleonora Santos — coluna na BHAZ",
  imageContain: true,
  variant: "black",
};

const votoDeJubiloCard: FeaturedCard = {
  href: "https://www.instagram.com/p/DeSDHGwJPE7/",
  external: true,
  eyebrow: "Na Mídia",
  title:
    "Voto de Júbilo da Câmara Municipal de São Paulo pelo livro (IN)FINITUDES",
  excerpt:
    "Eleonora Santos recebeu o Voto de Júbilo da Câmara Municipal de São Paulo pelo livro (IN)FINITUDES, registro nos anais da Casa.",
  meta: "(IN)FINITUDES",
  image: "/na-midia-thumbs/instagram-voto-de-jubilo.jpg",
  imageAlt:
    "Voto de Júbilo da Câmara Municipal de São Paulo pelo livro (IN)FINITUDES",
  variant: "rouge",
};

const featuredCards: FeaturedCard[] = [
  ...(await Promise.all(
    hubPosts.map((post) => publicationCard(post, "Hub Infinito")),
  )),
  ...(await Promise.all(
    naMidiaPosts.map((post) => publicationCard(post, "Na Mídia")),
  )),
  bhazCard,
  youtubeChannelCard,
  ...(await Promise.all(
    curadoriaPosts.map((post) => publicationCard(post, "Curadoria")),
  )),
  votoDeJubiloCard,
];

// Hero · masthead + assinatura institucional fixa
const heroContent = {
  manifesto:
    "O infinito faz parte da discussão do projeto, que vai da finitude da vida à infinitude das relações, dos laços e das formas de se ver e de se colocar na vida, da possibilidade de se construir pontes de acolhimento e aconchego em meio às incertezas.",
  edition: "Projeto cultural idealizado por Eleonora Santos",
};

// Fragmento de capa · "Deus, a morte e a infinitude" — texto integral
// exibido no bloco de capa da home (sem link para página dedicada).
const fragmentoParagraphs = [
  "Quantos de nós somos realmente capazes de nos sentir acolhidos por Deus quando vivemos a morte de uma pessoa muito amada?",
  "Quantos de nós vivemos muito mais o clamor da piedade para estancar a dor do que a confiança de que Deus está realmente nos acolhendo?",
  "Quando nos sentimos realmente amados em meio a profundas dores e sentimentos de desamparo? Dores viscerais de desamparo e abandono, dores cobertas de medo e desproteção, dores da alma, dores…",
  "Nem sempre a dor vem como resultado de um ato concreto; ela pode ser fruto do intangível, da história não contada de um ambiente silenciado. Sua origem, talvez pouco importe, mas sua permanência, importa muito.",
  "A escuta é o passo para o acolhimento. A escuta interior é o maior passo para a superação. É o olhar para dentro, o escutar das batidas do coração embaladas por notas de presença divina - o refúgio mais certo.",
  "Na dicotomia da escuta, a dor ocupa os espaços do vazio, mas o esvaziamento interior preenche e aquece, constrói a ponte do amor acalentador.",
  "A dor da morte questiona a presença de Deus, ocupa o corpo e a mente, traz novo sentido ao existir, em especial ao existir que não mais existe.",
  "E onde está Deus? Está ali onde aparenta nada mais existir. Ocupa todo o vazio infinito, reconstitui o propósito e produz mudança pelo sentido. Onde está o inalcançável, o infinito, Deus lá está a nos esperar.",
];

// Vitrine "Recomendamos" · grid das 3 últimas publicações da
// categoria recomenda (mesmo layout do grid de 3 posts acima).
// Se a categoria estiver vazia no Sanity, o bloco simplesmente
// não é renderizado (sem fake) — o grid superior já cobre a vitrine.
const recommendationsRaw = posts
  .filter((p) => p.category === "recomenda")
  .slice(0, 3);

// Capas locais para recomendações sem `mainImage` no Sanity (mesmo mapeamento
// usado em /recomenda). `position` ajusta o object-position no recorte 4:3.
const LOCAL_THUMBS: Record<
  string,
  { url: string; position?: "top" | "center" | "bottom" }
> = {
  "lancamento-infinitudes-palacio-das-artes": {
    url: "/recomenda-thumbs/lancamento-palacio-das-artes.webp",
    position: "top",
  },
  "jornada-de-um-paciente-oncologico-drauziocast-265": {
    url: "/recomenda-thumbs/jornada-de-um-paciente-oncologico-drauziocast-265.webp",
  },
};

const recommendationCards = await Promise.all(
  recommendationsRaw.map(async (p) => {
    const local = LOCAL_THUMBS[p.slug];
    return {
      post: p,
      externalImageUrl: p.mainImage
        ? null
        : (local?.url ?? (await resolveExternalThumb(p.externalUrl))),
      imagePosition: local?.position ?? null,
    };
  }),
);

---

<Layout
  title="(In)finitudes"
  description="Projeto cultural idealizado por Eleonora C. Santos. Inclui um livro, podcasts, histórias reais, escritas femininas e divulgação de temas relacionados à ciência, à saúde e à espiritualidade."
>
  <Header />

  <main>
    {/* 1 · Capa de revista · manifesto editorial + aquarela vermelha */}
    <HeroFeatured hero={heroContent} />

    {/* Divisor fino entre o manifesto superior e o artigo de capa */}
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="border-t border-rule"></div>
    </div>

    {/* 2 · Fragmento de capa · aquarela preta à esquerda + texto integral
         à direita (sem link — o texto completo vive aqui na home). */}
    <section>
      <div class="max-w-7xl mx-auto px-6 lg:px-12 py-20 lg:py-28">
        <div
          class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start"
        >
          {/* Coluna esquerda · aquarela preta (peça gráfica, fixa ao rolar) */}
          <div
            class="lg:col-span-5 flex justify-center lg:justify-start lg:sticky lg:top-28 self-start lg:-mt-10"
          >
            <img
              src="/watercolors/black-figure.webp"
              alt=""
              role="presentation"
              aria-hidden="true"
              loading="lazy"
              decoding="async"
              class="pointer-events-none select-none w-[320px] sm:w-[400px] lg:w-[440px] h-auto"
            />
          </div>

          {/* Coluna direita · eyebrow + título + autora + texto integral */}
          <div class="lg:col-span-7">
            <p class="eyebrow">Fragmentos</p>
            <h2
              class="font-serif text-[23px] sm:text-[27px] lg:text-[33px] leading-[1.12] mt-4 font-normal tracking-[-0.01em]"
            >
              Deus, a morte e a infinitude
            </h2>
            <p class="meta mt-2">Eleonora Santos</p>

            <div
              class="font-serif text-[13px] lg:text-[14px] leading-[1.65] mt-6 space-y-4 text-ink-soft"
            >
              {fragmentoParagraphs.map((p) => <p>{p}</p>)}
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Divisor de seção · eyebrow centralizado entre linhas finas */}
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="flex items-center gap-6 py-10 lg:py-14">
        <span class="flex-1 h-px bg-rule"></span>
        <span class="eyebrow whitespace-nowrap">No portal</span>
        <span class="flex-1 h-px bg-rule"></span>
      </div>
    </div>

    {/* 3 · Três linhas: Hub, Na Mídia, Divã + Curadoria + Voto de Júbilo.
         Legenda curta, no máximo duas linhas. */}
    <section class="max-w-7xl mx-auto px-6 lg:px-12 pb-16 lg:pb-24">
      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-y-14 md:gap-x-10 lg:gap-x-14"
      >
        {
          featuredCards.map((card) => (
            <article class="group">
              <a
                href={card.href}
                {...(card.external
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
                class="block"
              >
                {card.image ? (
                  card.imageContain ? (
                    <div class="w-full aspect-[4/3] bg-paper-soft overflow-hidden flex items-center justify-center">
                      <img
                        src={card.image}
                        alt={card.imageAlt}
                        class="max-h-full max-w-full object-contain transition-[filter] duration-300 group-hover:brightness-95"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  ) : (
                    <img
                      src={card.image}
                      alt={card.imageAlt}
                      class={`w-full aspect-[4/3] object-cover ${card.imagePosition ?? ""} transition-[filter] duration-300 group-hover:brightness-95`}
                      loading="lazy"
                      decoding="async"
                      onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','mqdefault')"
                    />
                  )
                ) : (
                  <div class="relative w-full aspect-[4/3] overflow-hidden bg-paper-soft">
                    <img
                      src={
                        card.variant === "rouge"
                          ? "/watercolors/rouge-blob.webp"
                          : "/watercolors/black-blob.webp"
                      }
                      alt=""
                      role="presentation"
                      aria-hidden="true"
                      loading="lazy"
                      decoding="async"
                      class="pointer-events-none select-none absolute inset-0 w-full h-full object-cover transition-[filter] duration-300 group-hover:brightness-95"
                    />
                    <div class="absolute inset-0 flex items-center justify-center p-8">
                      <picture>
                        <source
                          srcset="/logo/logo-mini.webp"
                          type="image/webp"
                        />
                        <img
                          src="/logo/logo-mini.png"
                          alt={card.imageAlt}
                          loading="lazy"
                          decoding="async"
                          class="select-none w-[42%] h-auto"
                          draggable="false"
                        />
                      </picture>
                    </div>
                  </div>
                )}

                <span class="eyebrow mt-5 block">{card.eyebrow}</span>

                <h3 class="font-serif text-[18px] lg:text-[20px] leading-[1.2] mt-2 font-medium tracking-[-0.005em] text-pretty transition-colors group-hover:text-rouge">
                  {card.title}
                  {card.external && (
                    <span class="ml-1 align-middle" aria-hidden="true">
                      ↗
                    </span>
                  )}
                </h3>

                {
                  card.excerpt && (
                    <p class="font-serif text-[13px] lg:text-[14px] leading-[1.4] mt-2 text-ink/75 line-clamp-2 text-pretty">
                      {card.excerpt}
                    </p>
                  )
                }

                <div class="meta mt-2">{card.meta}</div>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    {/* 4 · Banner bordô · livro (break section full-width intencional) */}
    <BookSection />

    {/* 5 · Vitrine de Recomendamos · grid das 3 últimas publicações */}
    {
      recommendationCards.length > 0 && (
        <>
          <div class="max-w-7xl mx-auto px-6 lg:px-12">
            <div class="flex items-center gap-6 py-10 lg:py-14">
              <span class="flex-1 h-px bg-rule" />
              <span class="eyebrow whitespace-nowrap">Recomenda</span>
              <span class="flex-1 h-px bg-rule" />
            </div>
          </div>
          <section class="max-w-7xl mx-auto px-6 lg:px-12 pb-16 lg:pb-24">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-y-14 md:gap-x-10 lg:gap-x-14">
              {recommendationCards.map(({ post, externalImageUrl, imagePosition }) => (
                <PostCard
                  post={post}
                  externalImageUrl={externalImageUrl}
                  imagePosition={imagePosition}
                />
              ))}
            </div>
            <div class="mt-12 lg:mt-16 flex justify-center">
              <a
                href="/recomenda"
                class="inline-block border border-rouge text-rouge px-10 py-3.5 text-[11px] font-medium tracking-[0.22em] uppercase hover:bg-rouge hover:text-paper transition-colors"
              >
                Ver mais
              </a>
            </div>
          </section>
        </>
      )
    }

    {/* 6 · Newsletter */}
    <NewsletterSection />
  </main>

  <Footer />
</Layout>
