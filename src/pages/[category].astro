---
// =============================================================
// [category].astro · Listagem por categoria (page-03)
// -------------------------------------------------------------
// Gera uma página estática para cada uma das categorias do portal.
// Layout do design:
//   1. SectionTitle ("SEÇÃO" / nome / subtítulo italic)
//   2. Linha vermelha fina + lista vertical de posts (PostListItem)
//      separados por linha vermelha fina
//   3. NewsletterSection
//   4. Footer
// =============================================================
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionTitle from "../components/SectionTitle.astro";
import PostListItem from "../components/PostListItem.astro";
import NewsletterSection from "../components/NewsletterSection.astro";
import Divider from "../components/Divider.astro";
import HubCollaboratorsStrip from "../components/HubCollaboratorsStrip.astro";
import { CATEGORIES, getCategoriesMerged } from "../lib/categories";
import { getPostsByCategory } from "../lib/sanity";
import { resolveCollaborators } from "../lib/collaborators";

export async function getStaticPaths() {
  // Categorias que JÁ TÊM página dedicada (sobrescrevem a rota dinâmica).
  // Excluímos para evitar conflito de rotas e warnings de build.
  // OBS: precisa ficar DENTRO de getStaticPaths porque o Astro avalia
  // essa função em isolamento (não enxerga consts do escopo do módulo).
  const DEDICATED_ROUTES = new Set([
    "diva-infinito",
    "sobre",
    "recomenda",
    "curadoria",
  ]);

  return CATEGORIES.filter((cat) => !DEDICATED_ROUTES.has(cat.value)).map(
    (cat) => ({
      params: { category: cat.value },
      props: { categoryValue: cat.value },
    }),
  );
}

const { categoryValue } = Astro.props as { categoryValue: string };
// Busca a categoria com overrides do Sanity (longDescription, disclaimer etc.)
const merged = await getCategoriesMerged();
const category = merged.find((c) => c.value === categoryValue)!;
const posts = await getPostsByCategory(categoryValue);

// Parágrafos do bloco "O que é?" — quebra em \n\n permite múltiplos
// parágrafos sem precisar de portable text para esses textos curtos.
const longDescriptionParagraphs = (category.longDescription ?? "")
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);

// Algumas categorias pedem o artigo "o" antes do nome no título da
// pergunta ("O que é o Hub Infinito?"). Mapeamos aqui as exceções.
const ARTICULATED_CATEGORIES = new Set(["hub-infinito"]);
const whatIsLabel = ARTICULATED_CATEGORIES.has(category.value)
  ? `O que é o ${category.title}?`
  : `O que é ${category.title}?`;

const hasRealPosts = posts.length > 0;

// Assinatura abreviada APENAS no Hub Infinito: nesta seção a autora assina
// como "Eleonora C. Santos" (no restante do site mantemos "Eleonora Cruz
// Santos" como está no Sanity). Override local, escopado à categoria.
const isHubInfinito = categoryValue === "hub-infinito";
const bylineOverride = (authors?: string | null) =>
  isHubInfinito && authors
    ? authors.replace("Eleonora Cruz Santos", "Eleonora C. Santos")
    : undefined;

// Colaboradoras do Hub Infinito (faixa-teaser). Só busca no Hub.
const collaborators = isHubInfinito ? await resolveCollaborators() : [];

// Aquarelas de fallback para posts sem `mainImage` — cada item da lista
// recebe uma diferente (ciclando) para dar variedade visual às capas.
const FALLBACK_WATERCOLORS = [
  "/watercolors/rouge-blob.webp",
  "/watercolors/black-figure.webp",
  "/watercolors/black-blob.webp",
  "/watercolors/black-ink.webp",
  "/watercolors/rouge-blob-hero.webp",
];
---

<Layout
  title={`${category.title} — (In)finitudes`}
  description={category.description}
>
  <Header />

  <main>
    {/* 1 · Cabeçalho de seção (eyebrow + título + subtítulo italic)
        Quando a categoria tem bloco "O que é?" preenchido (longDescription),
        omitimos o subtítulo italic — a explicação detalhada abaixo o substitui. */}
    <section class="max-w-5xl mx-auto px-6 lg:px-12">
      <SectionTitle
        eyebrow="Seção"
        title={category.title}
        subtitle={category.longDescription ? undefined : category.description}
      />
    </section>

    {/* 2 · Bloco "O que é?" — só aparece se a categoria tiver longDescription */}
    {
      longDescriptionParagraphs.length > 0 && (
        <section class="bg-paper-soft border-y border-rule/60">
          <div class="max-w-3xl mx-auto px-6 py-14 lg:py-20 text-center">
            <p class="eyebrow text-rouge">{whatIsLabel}</p>
            <div class="font-serif text-[18px] lg:text-[20px] leading-[1.6] mt-5 text-ink-soft space-y-4">
              {longDescriptionParagraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {/* 2.5 · Faixa "Quem faz o Hub Infinito?" — só no Hub, entre o
         bloco "O que é?" e a lista de artigos. */}
    {isHubInfinito && <HubCollaboratorsStrip items={collaborators} />}

    {/* 3 · Lista vertical com hairlines bordô entre os itens */}
    <section
      class={`max-w-5xl mx-auto px-6 lg:px-12 ${category.longDescription ? "pt-16 lg:pt-20" : ""} pb-16 lg:pb-24`}
    >
      <Divider variant="rouge" />
      {
        hasRealPosts ? (
          posts.map((post, idx) => (
            <>
              <PostListItem
                post={post}
                author={bylineOverride(post.authors)}
                fallbackWatercolor={
                  FALLBACK_WATERCOLORS[idx % FALLBACK_WATERCOLORS.length]
                }
              />
              <Divider variant="rouge" />
            </>
          ))
        ) : (
          <div class="text-center py-16 lg:py-24">
            <p class="eyebrow text-rouge">Em breve</p>
            <p class="font-serif italic text-[18px] lg:text-[20px] leading-[1.55] mt-5 text-ink-soft max-w-xl mx-auto">
              Primeiros artigos em curadoria — publicações iniciais previstas
              para os próximos meses.
            </p>
          </div>
        )
      }
    </section>

    {/* 4 · Disclaimer da categoria — só aparece se preenchido */}
    {
      category.disclaimer && (
        <aside
          class="max-w-5xl mx-auto px-6 lg:px-12 pb-16 lg:pb-20"
          aria-label="Aviso editorial"
        >
          <div class="border-t border-rule/50 pt-8">
            <p class="font-sans text-[11px] font-medium tracking-[0.22em] uppercase text-rouge mb-3">
              Aviso editorial
            </p>
            <p class="font-serif text-[13px] lg:text-[14px] leading-[1.6] text-ink/65">
              {category.disclaimer}
            </p>
          </div>
        </aside>
      )
    }

    {/* 5 · Newsletter */}
    <NewsletterSection />
  </main>

  <Footer />
</Layout>
