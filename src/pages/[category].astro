---
// =============================================================
// [category].astro · Listagem por categoria (page-03)
// -------------------------------------------------------------
// Gera uma página estática para cada uma das categorias do portal.
// Layout do design:
//   1. SectionTitle ("SEÇÃO" / nome / subtítulo italic)
//   2. Linha vermelha fina + lista vertical de posts (PostListItem)
//      separados por linha vermelha fina
//   3. NewsletterSection
//   4. Footer
// =============================================================
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionTitle from "../components/SectionTitle.astro";
import PostListItem from "../components/PostListItem.astro";
import NewsletterSection from "../components/NewsletterSection.astro";
import Divider from "../components/Divider.astro";
import { CATEGORIES, getCategory } from "../lib/categories";
import { getPostsByCategory } from "../lib/sanity";
import type { PostPreview } from "../lib/sanity";

export async function getStaticPaths() {
  return CATEGORIES.map((cat) => ({
    params: { category: cat.value },
    props: { categoryValue: cat.value },
  }));
}

const { categoryValue } = Astro.props as { categoryValue: string };
const category = getCategory(categoryValue)!;
const posts = await getPostsByCategory(categoryValue);

// Fake list editorial (estado "vazio apresentável") usado quando ainda
// não há posts cadastrados na categoria. Reproduz o tom da page-03.
const FAKE_POSTS: Array<{ post: PostPreview; author: string }> = [
  {
    post: {
      _id: "fake-1",
      title: "Shutfalo: Wednesday, May 6, 2026",
      slug: "shutfalo-may-6",
      publishedAt: "2026-05-06",
      mainImage: null,
      category: categoryValue,
      excerpt: "Can you make a longer word with each new letter?",
    },
    author: "",
  },
  {
    post: {
      _id: "fake-2",
      title: "Muriel Spark, the Double Agent",
      slug: "muriel-spark-double-agent",
      publishedAt: "2026-05-06",
      mainImage: null,
      category: categoryValue,
      excerpt:
        "A new biography claims that novelist fabricated her origin story — but that secret codes lie at the heart of her genius.",
    },
    author: "Por Eleonora Cruz Santos",
  },
  {
    post: {
      _id: "fake-3",
      title: "How the Iran War Is Shifting Power Toward China",
      slug: "iran-war-china",
      publishedAt: "2026-05-06",
      mainImage: null,
      category: categoryValue,
      excerpt:
        "As the U.K.'s credibility and military capacity are tested abroad, China has gained leverage by staying out the fight and learning from it.",
    },
    author: "Por Eleonora Cruz Santos",
  },
  {
    post: {
      _id: "fake-4",
      title: "The Crossword Wednesday, May 6, 2026",
      slug: "crossword-may-6",
      publishedAt: "2026-05-06",
      mainImage: null,
      category: categoryValue,
      excerpt: "Earth's driest and coldest continent: ten letters.",
    },
    author: "Por Eleonora Cruz Santos",
  },
];

const hasRealPosts = posts.length > 0;
---

<Layout
  title={`${category.title} — (IN)Finitudes`}
  description={category.description}
>
  <Header />

  <main>
    {/* 1 · Cabeçalho de seção (eyebrow + título + subtítulo italic) */}
    <section class="max-w-5xl mx-auto px-6 lg:px-12">
      <SectionTitle
        eyebrow="Seção"
        title={category.title}
        subtitle={category.description}
      />
    </section>

    {/* 2 · Lista vertical com hairlines bordô entre os itens */}
    <section class="max-w-5xl mx-auto px-6 lg:px-12 pb-16 lg:pb-24">
      <Divider variant="rouge" />
      {
        hasRealPosts ? (
          posts.map((post) => (
            <>
              <PostListItem post={post} />
              <Divider variant="rouge" />
            </>
          ))
        ) : (
          FAKE_POSTS.map((item) => (
            <>
              <PostListItem post={item.post} author={item.author} />
              <Divider variant="rouge" />
            </>
          ))
        )
      }
    </section>

    {/* 3 · Newsletter */}
    <NewsletterSection />
  </main>

  <Footer />
</Layout>
