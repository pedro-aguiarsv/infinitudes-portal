---
// =============================================================
// /sobre · Página "Sobre o (In)finitudes"
// -------------------------------------------------------------
// Rota estática que sobrescreve a dinâmica `[category].astro`.
//
// Estrutura editorial:
//   1. SectionTitle "Sobre o (In)finitudes"
//   2. Texto explicativo do projeto (Sanity → projectDescription,
//      com fallback editorial)
//   3. Newsletter
// =============================================================
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionTitle from "../components/SectionTitle.astro";
import NewsletterSection from "../components/NewsletterSection.astro";
import { PortableText } from "astro-portabletext";
import PTBlock from "../components/portable-text/PTBlock.astro";
import { getAboutPage } from "../lib/sanity";

const about = await getAboutPage();

// Fallback editorial enquanto o Sanity não tem `projectDescription`
// preenchido. Foca no PROJETO, não em uma pessoa só.
const FAKE_PROJECT_DESCRIPTION = [
  "O (In)finitudes é um projeto cultural idealizado por Eleonora Santos que une jornalismo, literatura e escuta em torno de um tema ainda em silêncio na cultura brasileira: os processos de adoecimento, o fim da vida e a espiritualidade que os atravessa.",
  "Reúne artigos, entrevistas, recomendações e um podcast — o Divã Infinito — que conversa com médicos, pacientes, teólogos e cuidadores sobre histórias reais e os efeitos psíquicos, espirituais e relacionais do cuidado.",
  "O projeto (In)finitudes tem a proposta de extrair as falas de dentro — o “in” do latim — e assim deixar registros que possam contribuir para o crescimento humano e espiritual de cada um que ler o livro ou assistir aos podcasts.",
];

const hasRealDescription =
  Array.isArray(about?.projectDescription) &&
  about!.projectDescription!.length > 0;

const ptComponents = {
  block: {
    normal: PTBlock,
    h2: PTBlock,
    h3: PTBlock,
    blockquote: PTBlock,
  },
};
---

<Layout
  title="Sobre o (In)finitudes — (In)finitudes"
  description="Um projeto cultural sobre cuidado, finitude e espiritualidade — artigos, entrevistas e o podcast Divã Infinito."
>
  <Header />

  <main>
    {/* 1 · Cabeçalho da página */}
    <section class="max-w-5xl mx-auto px-6 lg:px-12">
      <SectionTitle eyebrow="Seção" title="Sobre o (In)finitudes" />
    </section>

    {/* 2 · Texto explicativo do projeto */}
    <section
      class="max-w-2xl mx-auto px-6 pb-16 lg:pb-20 font-serif text-[17px] lg:text-[18px] leading-[1.7] space-y-5 text-ink-soft"
    >
      {
        hasRealDescription ? (
          <PortableText
            value={about!.projectDescription as unknown[]}
            components={ptComponents}
          />
        ) : (
          FAKE_PROJECT_DESCRIPTION.map((p) => <p>{p}</p>)
        )
      }
    </section>

    {/* 3 · Newsletter */}
    <NewsletterSection />
  </main>

  <Footer />
</Layout>
