---
// =============================================================
// /livro · Página de venda do livro "(In)finitudes"
// -------------------------------------------------------------
// Conteúdo vem do Sanity (`bookInfo` singleton + `testimonial`).
// Quando os documentos não existem, cai em conteúdo fake editorial
// para que a página funcione mesmo durante a fase de povoamento.
// =============================================================
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NewsletterSection from "../components/NewsletterSection.astro";
import BookCover from "../components/BookCover.astro";
import Divider from "../components/Divider.astro";
import { PortableText } from "astro-portabletext";
import PTBlock from "../components/portable-text/PTBlock.astro";
import {
  getBookInfo,
  getTestimonialsForBook,
  urlFor,
  type Testimonial,
} from "../lib/sanity";

const [book, testimonials] = await Promise.all([
  getBookInfo(),
  getTestimonialsForBook(),
]);

// ----- Resolução de campos com fallback ---------------------
const bookTitle = book?.title ?? "(In)finitudes";
const bookSubtitle =
  book?.subtitle ??
  "Além da própria autora, o livro traz relatos de outros 19 pacientes diagnosticados com câncer, além de visões de pessoas que estão do outro lado da história — os filhos da autora e uma mãe que perdeu seu jovem filho.";
const bookAuthor = book?.author ?? "Eleonora Santos";
// Preço cheio do livro (sem promoção). A versão promocional "De/Por"
// fica guardada em `_livro-promocional.astro` para reativação futura.
const bookPrice = book?.price ?? "R$ 59,00";
// Preço original (de tabela), exibido riscado antes do promocional.
const bookOriginalPrice = book?.originalPrice ?? "R$ 69,00";
const launchEdition = book?.launchEdition ?? "Edição 2026";
const ctaText = book?.ctaText ?? "Compre aqui";
// Loja oficial hospedada na Nuvem Shop. Link aponta direto pro produto;
// abre em nova aba via target="_blank" nos dois <a> que usam `cartHref`.
const cartHref =
  "https://projetoinfinitudes.lojavirtualnuvem.com.br/produtos/livro-infinitudes/";

const coverUrl = book?.cover
  ? urlFor(book.cover).width(720).height(960).fit("crop").auto("format").url()
  : null;
const coverAlt = book?.cover?.alt ?? `Capa do livro ${bookTitle}`;

// Renderização do título: parênteses em bordô SEM espaços extras.
// Usamos replace + set:html para evitar que o JSX insira whitespace
// entre os <span>s e o texto adjacente (bug que causava "( In) finitudes").
const formattedBookTitle = bookTitle.replace(
  /\(([^)]+)\)/g,
  '<span class="text-rouge">(</span>$1<span class="text-rouge">)</span>',
);

// Sinopse · usa Portable Text se existir, senão texto padrão
const hasSynopsis =
  Array.isArray(book?.synopsis) && book!.synopsis!.length > 0;

// ----- Detalhes técnicos expandíveis ------------------------
// Consolida ficha catalográfica, equipe editorial e fomento.
// Toda info "fria" do livro mora aqui (atrás do toggle).
const FAKE_TECH_DETAILS = [
  { label: "Páginas", value: "180" },
  { label: "Formato", value: "22 cm" },
  { label: "Idioma", value: "Português (Brasil)" },
  { label: "Editora", value: "Literíssima · Belo Horizonte" },
  { label: "Edição", value: "1ª · 2026" },
  { label: "ISBN", value: "978-65-5079-651-8" },
  { label: "Lançamento", value: "22 de junho de 2026" },
  { label: "Editor", value: "Iago Passos" },
  { label: "Assistência editorial", value: "Alícia Teodoro" },
  { label: "Projeto gráfico e diagramação", value: "Albino Papa" },
  { label: "Revisão", value: "Maria do Rosário Alves Pereira" },
  { label: "Revisão de conteúdo", value: "Nícia Raies Moreira de Souza" },
  {
    label: "Fomento",
    value: "Lei de Incentivo à Cultura (Lei nº 8.313/1991)",
  },
];

const technicalDetails: Array<{ label: string; value: string }> =
  Array.isArray(book?.technicalDetails) && book!.technicalDetails!.length > 0
    ? book!.technicalDetails!
        .filter((d) => d.label && d.value)
        .map((d) => ({ label: d.label as string, value: d.value as string }))
    : FAKE_TECH_DETAILS;

// ----- Amostra do livro (PDF) -------------------------------
const samplePdfUrl = book?.samplePdfUrl ?? null;
const hasSample = Boolean(samplePdfUrl);

// Depoimentos · seção "Disseram sobre o livro"
// Quando NÃO há `testimonials` cadastrados no Sanity, exibimos um único
// destaque editorial (trecho da coluna "As infinitas vozes de Eleonora Santos",
// da jornalista Nalu Saad) — dialoga diretamente com a tese do livro de
// rejeitar a "lógica da superação obrigatória".
const FAKE_TESTIMONIAL_HIGHLIGHT: Testimonial = {
  _id: "fake-nalu-saad",
  quote:
    "Nem todas as histórias terminaram bem. Algumas pessoas entrevistadas morreram antes do lançamento do livro. E essa talvez seja uma das decisões mais honestas de Infinitudes: não transformar o adoecimento em uma narrativa simplificada de vitória. A autora conta que queria rejeitar a lógica da “superação obrigatória”.",
  author: "Nalu Saad",
  role: "Coluna · “As infinitas vozes de Eleonora Santos”",
};

const showTestimonials =
  testimonials.length > 0 ? testimonials : [FAKE_TESTIMONIAL_HIGHLIGHT];

// URL da matéria/coluna referente ao testimonial em destaque (lado esquerdo
// da seção "Em outra voz" + "Conversa em vídeo"). Se preenchida, exibe o
// botão "Ler matéria"; se `null`, o botão é omitido. Hardcoded pq é um
// destaque editorial fixo — quando trocar o testimonial em destaque,
// atualizar (ou zerar) este valor.
const featuredTestimonialUrl: string | null =
  "https://bhaz.com.br/colunas/siga-essa-mulher/as-infinitas-vozes-de-eleonora-santos/";

const ptComponents = {
  block: {
    normal: PTBlock,
    h2: PTBlock,
    h3: PTBlock,
    blockquote: PTBlock,
  },
};
---

<Layout
  title={`Livro ${bookTitle} — ${bookAuthor}`}
  description={bookSubtitle}
>
  <Header />

  <main>
    {/* ============================================================
        1 · HERO · capa + título + CTA + amostra
        ============================================================ */}
    <section class="bg-paper">
      <div class="max-w-6xl mx-auto px-6 lg:px-12 py-14 lg:py-20">
        <div
          class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center"
        >
          {/* Capa + botão de amostra */}
          <div class="lg:col-span-6 flex flex-col items-center order-2 lg:order-1">
            <div class="relative w-[280px] sm:w-[320px] lg:w-[360px]">
              <div
                class="absolute inset-0 translate-x-3 translate-y-3 bg-ink/10"
                aria-hidden="true"
              />
              {
                coverUrl ? (
                  <img
                    src={coverUrl}
                    alt={coverAlt}
                    class="relative w-full aspect-[3/4] object-cover shadow-2xl"
                    loading="eager"
                  />
                ) : (
                  <BookCover
                    variant="full"
                    loading="eager"
                    class="relative w-full shadow-2xl"
                  />
                )
              }
            </div>

            {/* Botão de amostra (estilo Amazon "Look inside") — só aparece
                quando há PDF cadastrado no Sanity. Sem PDF, nenhum botão
                de amostra é exibido. */}
            {
              hasSample && (
                <button
                  type="button"
                  data-open-sample
                  class="mt-6 inline-flex items-center gap-2 border border-rouge text-rouge px-6 py-2.5 text-[11px] font-medium tracking-[0.22em] uppercase hover:bg-rouge hover:text-paper transition-colors"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    class="w-4 h-4"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"
                    />
                  </svg>
                  Ler uma amostra
                </button>
              )
            }
          </div>

          {/* Headline + CTA */}
          <div class="lg:col-span-6 order-1 lg:order-2 text-center lg:text-left">
            <p class="eyebrow">{launchEdition}</p>
            <h1
              class="font-display text-[44px] sm:text-[56px] lg:text-[72px] leading-[1.02] mt-3 font-normal tracking-[-0.01em] uppercase"
              set:html={formattedBookTitle}
            ></h1>
            <p
              class="font-serif italic text-[19px] lg:text-[22px] leading-[1.45] mt-5 text-ink/80"
            >
              {bookSubtitle}
            </p>
            <p
              class="mt-4 font-sans text-[11px] font-medium tracking-[0.22em] uppercase text-rouge"
            >
              por {bookAuthor}
            </p>

            {/* Preço promocional · "De R$ 69,00" riscado + "Por R$ 59,00 + frete". */}
            <div class="mt-8">
              <p
                class="text-center sm:text-left font-sans text-[12px] tracking-[0.06em] text-ink/55 line-through decoration-rouge/70 decoration-[1.5px]"
              >
                De {bookOriginalPrice}
              </p>
              <div
                class="mt-2 flex flex-col sm:flex-row sm:items-center sm:justify-center lg:justify-start gap-4"
              >
                <span
                  class="font-display italic text-[26px] lg:text-[28px] text-ink leading-none text-center sm:text-left"
                >
                  Por {bookPrice}
                  <span class="font-sans not-italic text-[10px] font-medium tracking-[0.22em] uppercase text-ink/55 ml-1.5 align-middle relative -top-1">
                    + frete
                  </span>
                </span>
                <a
                  href={cartHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block text-center bg-rouge text-paper px-8 py-3.5 text-[11px] font-medium tracking-[0.22em] uppercase hover:bg-rouge-deep transition-colors"
                >
                  {ctaText}
                </a>
              </div>
            </div>
            <p class="meta mt-4">
              Envio nacional a partir de 22 de junho de 2026
            </p>
            {
              technicalDetails.length > 0 && (
                <details class="book-details mt-3 group">
                  <summary class="inline-flex items-center gap-1.5 font-sans text-[10px] font-medium tracking-[0.22em] uppercase text-rouge cursor-pointer select-none hover:text-rouge-deep transition-colors list-none">
                    Detalhes técnicos
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="w-3 h-3 transition-transform duration-200 group-open:rotate-180"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.06l3.71-3.83a.75.75 0 1 1 1.08 1.04l-4.25 4.38a.75.75 0 0 1-1.08 0L5.21 8.27a.75.75 0 0 1 .02-1.06Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </summary>
                  <div class="mt-4 p-5 bg-paper-soft border border-rule/40 lg:max-w-md">
                    <dl class="space-y-2">
                      {technicalDetails.map((d) => (
                        <div class="flex justify-between gap-4 text-[12px] leading-snug">
                          <dt class="font-sans font-medium tracking-[0.10em] uppercase text-ink/65 text-[10px] pt-0.5 whitespace-nowrap">
                            {d.label}
                          </dt>
                          <dd class="font-serif text-ink/90 text-right">{d.value}</dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                </details>
              )
            }
          </div>
        </div>
      </div>
    </section>

    {/* ============================================================
        2 · SINOPSE
        ============================================================ */}
    <section class="bg-paper-soft border-y border-rule/60">
      <div class="max-w-3xl mx-auto px-6 py-16 lg:py-20 text-center">
        <p class="eyebrow">Sobre o livro</p>
        {
          hasSynopsis ? (
            <div class="font-serif text-[19px] lg:text-[21px] leading-[1.55] mt-6 text-ink-soft space-y-4">
              <PortableText value={book!.synopsis as unknown[]} components={ptComponents} />
            </div>
          ) : (
            <div class="font-serif text-[19px] lg:text-[21px] leading-[1.55] mt-6 text-ink-soft space-y-5 text-left">
              <p>
                Sete meses antes do diagnóstico, Eleonora notou que começaram
                a surgir “caroços” pelo corpo. Angústia e insegurança
                misturadas ao desejo de encarar a doença e se cuidar foram
                os sentimentos que a mobilizaram.
              </p>
              <p>
                Em todas as consultas médicas, Eleonora não quis que ninguém
                a acompanhasse; mantinha ótima relação com seus médicos e
                caminhava em silêncio espiritual, em diálogos interiores
                com o transcendente.
              </p>
              <p>
                Foi nessa jornada que se sentiu inspirada a ajudar outras
                pessoas em processo de tratamento, em busca de cura ou de
                conforto espiritual — para apoiá-las a seguirem com força e
                a lidar melhor com a perspectiva da morte: a finitude da
                vida.
              </p>
            </div>
          )
        }
      </div>
    </section>

    {/* ============================================================
        3 · SOBRE A AUTORA
        ============================================================ */}
    <section class="max-w-5xl mx-auto px-6 lg:px-12 py-16 lg:py-24">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class="md:col-span-5 flex justify-center">
          <div class="relative w-[240px] sm:w-[280px] aspect-[3/4]">
            <picture class="relative block w-full h-full overflow-hidden">
              <source srcset="/authors/eleonora.webp" type="image/webp" />
              <img
                src="/authors/eleonora.jpg"
                alt="Retrato em preto e branco de Eleonora Santos, autora do livro (In)finitudes"
                class="w-full h-full object-cover object-[center_22%] select-none"
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </picture>
          </div>
        </div>
        <div class="md:col-span-7">
          <p class="eyebrow">Sobre a autora</p>
          <h2
            class="font-display text-[32px] lg:text-[40px] leading-[1.1] mt-3 font-normal tracking-[-0.005em]"
          >
            {bookAuthor}
          </h2>
          <div
            class="font-serif text-[16px] lg:text-[17px] leading-[1.6] mt-5 text-ink/85 space-y-4"
          >
            <p>
              Eleonora Santos é economista, mestre em Demografia, doutora
              em Administração, pós-doutora em Economia (UFMG) e tem MBA
              Executivo pela Coppead-UFRJ. Iniciou sua carreira no Ipea-Rio
              na área de indicadores sociais e sempre teve um olhar voltado
              para o desenvolvimento humano. Ingressou no meio cultural ao
              assumir a direção da organização produtora da grade de
              programação da Rede TV Minas; mais tarde, tornou-se presidente
              do Conselho de Administração da EMC (Empresa Mineira de
              Comunicação), além de atuar em outros conselhos.
            </p>
            <p>
              Foi diretora da área de produção de estatísticas
              socioeconômicas da Fundação João Pinheiro-MG, economista em
              bancos de investimento e consultora em organismos
              internacionais. É colunista do jornal Estado de Minas,
              professora convidada da Educação Executiva da FGV e
              recentemente tornou-se produtora de podcasts.
            </p>
          </div>
          <a
            href="/sobre"
            class="inline-block mt-6 font-sans text-[11px] font-medium tracking-[0.22em] uppercase text-rouge link-ed"
          >
            Conheça a história do projeto →
          </a>
        </div>
      </div>
    </section>

    {/* ============================================================
        4 · O LIVRO EM OUTRAS VOZES
        Mescla, em duas colunas equivalentes:
          A) Depoimento em destaque sobre o livro (Sanity ou fallback
             editorial — coluna da Nalu Saad).
          B) Conversa em vídeo · Bucket List PodCast (Grupo Zelo /
             Gustavo Ziller) com link p/ YouTube.
        Cada coluna tem seu próprio eyebrow e CTA opcional para o
        material oficial. Se houver mais de 1 testimonial cadastrado
        no Sanity, os adicionais aparecem em grid abaixo.
        ============================================================ */}
    <section class="bg-paper-soft border-y border-rule/60">
      <div class="max-w-7xl mx-auto px-6 lg:px-12 py-16 lg:py-24">
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-x-12 lg:gap-x-20 gap-y-16"
        >
          {/* Lado A · Depoimento em destaque (Em outra voz) */}
          <article class="flex flex-col">
            <header class="text-center mb-8">
              <Divider variant="rouge" gap="mb-8 max-w-md mx-auto" />
              <p
                class="font-sans text-[11px] font-medium tracking-[0.30em] uppercase text-ink/80"
              >
                As infinitas vozes de Eleonora Santos
              </p>
            </header>

            <a
              href="https://bhaz.com.br/colunas/siga-essa-mulher/as-infinitas-vozes-de-eleonora-santos/"
              target="_blank"
              rel="noopener noreferrer"
              class="group block mb-8 w-full max-w-[240px] mx-auto"
              aria-label="As infinitas vozes de Eleonora Santos — coluna na BHAZ"
            >
              <img
                src="/authors/eleonora-bhaz.webp"
                alt="As infinitas vozes de Eleonora Santos — coluna na BHAZ, por Nalu Saad"
                loading="lazy"
                decoding="async"
                class="w-full aspect-[4/3] object-cover transition-[filter] duration-300 group-hover:brightness-95"
              />
            </a>

            <figure class="text-center flex-1 flex flex-col">
              <span
                class="font-display text-[64px] lg:text-[80px] leading-[1] text-rouge block"
              >
                “
              </span>
              <blockquote
                class="font-serif italic text-[17px] lg:text-[19px] leading-[1.55] mt-2 text-ink-soft max-w-[52ch] mx-auto"
              >
                {showTestimonials[0].quote}
              </blockquote>
              <figcaption class="mt-8">
                <span
                  class="block font-sans text-[10px] font-medium tracking-[0.22em] uppercase text-rouge"
                >
                  {showTestimonials[0].author}
                </span>
                {showTestimonials[0].role && (
                  <span class="meta block mt-1">
                    {showTestimonials[0].role}
                  </span>
                )}
              </figcaption>
            </figure>

            {featuredTestimonialUrl && (
              <div class="text-center mt-10">
                <a
                  href={featuredTestimonialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 bg-rouge text-paper px-7 py-3.5 text-[11px] font-medium tracking-[0.22em] uppercase hover:bg-rouge-deep transition-colors"
                >
                  Leia a matéria
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            )}
          </article>

          {/* Lado B · Conversa em vídeo · Bucket List */}
          <article class="flex flex-col">
            <header class="text-center mb-8">
              <Divider variant="rouge" gap="mb-8 max-w-md mx-auto" />
              <p
                class="font-sans text-[11px] font-medium tracking-[0.30em] uppercase text-ink/80"
              >
                Conversa em vídeo · Bucket List
              </p>
            </header>

            <a
              href="https://www.youtube.com/watch?v=cy-jyQ3kpDw"
              target="_blank"
              rel="noopener noreferrer"
              class="group block mb-8 w-full max-w-[240px] mx-auto"
              aria-label="Eleonora Santos no Bucket List PodCast"
            >
              <img
                src="https://i.ytimg.com/vi/cy-jyQ3kpDw/hqdefault.jpg"
                alt="Eleonora Santos no Bucket List PodCast"
                loading="lazy"
                decoding="async"
                class="w-full aspect-[4/3] object-cover transition-[filter] duration-300 group-hover:brightness-95"
              />
            </a>

            <figure class="text-center flex-1 flex flex-col">
              <span
                class="font-display text-[64px] lg:text-[80px] leading-[1] text-rouge block"
              >
                “
              </span>
              <blockquote
                class="font-serif italic text-[17px] lg:text-[19px] leading-[1.55] mt-2 text-ink-soft max-w-[52ch] mx-auto"
              >
                Toda vez que falavam comigo “vai dar tudo certo”, eu não tinha
                reação. Ficava calada olhando para a pessoa e, dentro de mim,
                pensava: o que você quer dizer com “vai dar tudo certo”? É a
                dificuldade que o outro tem de lidar com a finitude que está
                revelada no outro — e que é dele também.
              </blockquote>
              <figcaption class="mt-8">
                <span
                  class="block font-sans text-[10px] font-medium tracking-[0.22em] uppercase text-rouge"
                >
                  Eleonora Santos
                </span>
                <span class="meta block mt-1">
                  Bucket List PodCast · Grupo Zelo &amp; Gustavo Ziller ·
                  1h07min
                </span>
              </figcaption>
            </figure>

            <div class="text-center mt-10">
              <a
                href="https://www.youtube.com/watch?v=cy-jyQ3kpDw"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-rouge text-paper px-7 py-3.5 text-[11px] font-medium tracking-[0.22em] uppercase hover:bg-rouge-deep transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="w-3.5 h-3.5"
                  aria-hidden="true"
                >
                  <path d="M8 5v14l11-7z" />
                </svg>
                Assista no YouTube
              </a>
            </div>
          </article>
        </div>

        {/* Testimoniais adicionais (a partir do 2º) — mantém compatibilidade
            quando há vários cadastrados no Sanity */}
        {showTestimonials.length > 1 && (
          <div class="mt-20 pt-16 border-t border-rule/40">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-12">
              {showTestimonials.slice(1).map((d) => (
                <figure class="text-center">
                  <span class="font-display text-[48px] lg:text-[56px] leading-[1] text-rouge block">
                    “
                  </span>
                  <blockquote class="font-serif italic text-[16px] lg:text-[17px] leading-[1.55] mt-2 text-ink-soft">
                    {d.quote}
                  </blockquote>
                  <figcaption class="mt-5">
                    <span class="block font-sans text-[10px] font-medium tracking-[0.22em] uppercase text-rouge">
                      {d.author}
                    </span>
                    {d.role && <span class="meta block mt-1">{d.role}</span>}
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    {/* ============================================================
        5 · CTA FINAL
        ============================================================ */}
    <section class="bg-rouge text-paper">
      <div class="max-w-5xl mx-auto px-6 lg:px-12 py-16 lg:py-24 text-center">
        <p
          class="font-sans text-[11px] font-medium tracking-[0.30em] uppercase text-paper/80"
        >
          {launchEdition}
        </p>
        <h2
          class="font-display text-[36px] sm:text-[44px] lg:text-[56px] leading-[1.05] mt-4 font-normal tracking-[-0.01em] text-paper"
        >
          Garanta seu exemplar.
        </h2>
        <p
          class="font-serif italic text-[18px] lg:text-[20px] leading-[1.5] mt-5 text-paper/85 max-w-xl mx-auto"
        >
          Primeira tiragem limitada a 500 exemplares. Envio nacional a partir
          de 22 de junho.
        </p>
        <div
          class="mt-10 flex flex-col sm:flex-row gap-4 justify-center items-center"
        >
          {/* Preço promocional · original riscado + promocional + frete (versão clara sobre bordô) */}
          <div class="flex flex-col items-center gap-1">
            <span class="font-sans text-[12px] tracking-[0.06em] text-paper/60 line-through decoration-paper/80 decoration-[1.5px]">
              De {bookOriginalPrice}
            </span>
            <span class="font-display italic text-[28px] text-paper leading-none">
              Por {bookPrice}
              <span class="font-sans not-italic text-[10px] font-medium tracking-[0.22em] uppercase text-paper/70 ml-1.5 align-middle relative -top-1">
                + frete
              </span>
            </span>
          </div>
          <a
            href={cartHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-paper text-rouge px-10 py-4 text-[11px] font-medium tracking-[0.22em] uppercase hover:bg-paper-soft transition-colors"
          >
            Adicione no carrinho
          </a>
        </div>
      </div>
    </section>

    <NewsletterSection />
  </main>

  <Footer />

  {/* ============================================================
      Modal de amostra do livro (renderizado apenas se há PDF)
      ============================================================ */}
  {
    hasSample && samplePdfUrl && (
      <dialog
        id="sample-modal"
        aria-labelledby="sample-modal-title"
        class="m-0 p-0 w-screen h-screen max-w-none max-h-none bg-transparent backdrop:bg-black/70"
      >
        <div class="flex flex-col w-full h-full bg-paper">
          <header class="flex items-center justify-between px-6 py-3 border-b border-rule/60 bg-paper-soft">
            <p
              id="sample-modal-title"
              class="font-sans text-[11px] font-medium tracking-[0.22em] uppercase text-ink/80"
            >
              Amostra · {bookTitle}
            </p>
            <button
              type="button"
              data-close-sample
              aria-label="Fechar amostra"
              class="font-sans text-[11px] font-medium tracking-[0.22em] uppercase text-rouge hover:text-rouge-deep transition-colors"
            >
              Fechar ✕
            </button>
          </header>
          <iframe
            src={samplePdfUrl}
            title={`Amostra do livro ${bookTitle}`}
            class="flex-1 w-full border-0 bg-ink/5"
          ></iframe>
        </div>
      </dialog>

      <script is:inline>
        (function () {
          const dialog = document.getElementById("sample-modal");
          if (!dialog) return;
          const trigger = document.querySelector("[data-open-sample]");
          const closeBtn = document.querySelector("[data-close-sample]");

          trigger?.addEventListener("click", () => {
            if (typeof dialog.showModal === "function") {
              dialog.showModal();
            } else {
              dialog.setAttribute("open", "");
            }
          });

          closeBtn?.addEventListener("click", () => dialog.close());

          // Fechar ao clicar no backdrop (fora do conteúdo interno)
          dialog.addEventListener("click", (event) => {
            const rect = dialog.getBoundingClientRect();
            const inside =
              event.clientX >= rect.left &&
              event.clientX <= rect.right &&
              event.clientY >= rect.top &&
              event.clientY <= rect.bottom;
            // Como o <dialog> ocupa 100vw/100vh, clicar fora cai no próprio
            // dialog (não no .flex interno). Detectamos por event.target:
            if (event.target === dialog) dialog.close();
          });
        })();
      </script>
    )
  }
</Layout>

<style>
  /* Esconde a setinha padrão do navegador no <summary>, deixando só o ícone customizado */
  .book-details summary::-webkit-details-marker {
    display: none;
  }
  .book-details summary::marker {
    content: "";
  }
</style>
