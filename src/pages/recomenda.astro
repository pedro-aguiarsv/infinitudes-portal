---
// =============================================================
// /recomenda · Página "Recomendamos" (lista flat — padrão page-07)
// -------------------------------------------------------------
// Sobrescreve a rota dinâmica `[category].astro` para `/recomenda`.
//
// Layout (novo, inspirado em /diva-infinito):
//   1. SectionTitle "Recomendamos"
//   2. Bloco "O que é?" (se Sanity tiver longDescription preenchido)
//   3. Divider rouge
//   4. Lista vertical FLAT (todos os posts com mesmo peso visual)
//      · cada item: texto + CTA "Acessar" à esquerda, imagem à direita
//      · separados por hairline rouge
//   5. Disclaimer (se Sanity tiver disclaimer preenchido)
//   6. Newsletter + Footer
//
// Lê posts da categoria "recomenda" do Sanity. Quando vazio,
// cai em fake editorial pra manter "estado vazio apresentável".
// =============================================================
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionTitle from "../components/SectionTitle.astro";
import RecommendationListItem from "../components/RecommendationListItem.astro";
import NewsletterSection from "../components/NewsletterSection.astro";
import Divider from "../components/Divider.astro";
import { getCategoriesMerged } from "../lib/categories";
import { getPostsByCategory } from "../lib/sanity";

const [posts, merged] = await Promise.all([
  getPostsByCategory("recomenda"),
  getCategoriesMerged(),
]);

const category = merged.find((c) => c.value === "recomenda");

// Fake editorial enquanto o Sanity não tem recomendações cadastradas.
// Simula 3 tipos comuns: livro (Amazon), podcast (Spotify), evento (site).
type FakeRec = {
  title: string;
  excerpt: string;
  authors?: string;
  externalUrl: string;
};

const FAKE_RECS: FakeRec[] = [
  {
    title: "Cuidados paliativos: livro essencial sobre escuta no fim da vida",
    excerpt:
      "Leitura indicada para profissionais e familiares que acompanham processos de adoecimento — uma reflexão sobre presença, dor e linguagem.",
    authors: "Sugestão da redação",
    externalUrl: "https://www.amazon.com.br",
  },
  {
    title: "Podcast: Vida & Morte, conversas que precisamos ter",
    excerpt:
      "Série de episódios reúne médicos, teólogos e cuidadores para discutir cuidado paliativo, luto antecipado e espiritualidade.",
    authors: "Sugestão da redação",
    externalUrl: "https://open.spotify.com",
  },
  {
    title: "Evento: Simpósio Internacional de Cuidados Paliativos 2026",
    excerpt:
      "Encontro presencial e online com palestras de especialistas brasileiros e internacionais. Inscrições abertas.",
    authors: "Sugestão da redação",
    externalUrl: "https://www.example.com",
  },
];

const hasReal = posts.length > 0;
---

<Layout
  title="Recomendamos — (In)finitudes"
  description="O que lemos, assistimos, ouvimos."
>
  <Header />

  <main>
    {/* 1 · Cabeçalho de seção */}
    <section class="max-w-5xl mx-auto px-6 lg:px-12">
      <SectionTitle
        eyebrow="Seção"
        title="Recomendamos"
        subtitle={category?.longDescription
          ? undefined
          : "O que lemos, assistimos, ouvimos."}
      />
    </section>

    {/* 2 · Bloco "O que é?" — só aparece se a categoria tiver longDescription */}
    {
      category?.longDescription && (
        <section class="bg-paper-soft border-y border-rule/60">
          <div class="max-w-3xl mx-auto px-6 py-14 lg:py-20 text-center">
            <p class="eyebrow text-rouge">O que é Recomenda?</p>
            <p class="font-serif text-[18px] lg:text-[20px] leading-[1.6] mt-5 text-ink-soft">
              {category.longDescription}
            </p>
          </div>
        </section>
      )
    }

    {/* 3 · Lista flat de recomendações (mesmo padrão do /diva-infinito) */}
    <section
      class={`max-w-5xl mx-auto px-6 lg:px-12 ${category?.longDescription ? "pt-16 lg:pt-20" : ""} pb-16 lg:pb-24`}
    >
      <Divider variant="rouge" />
      {
        hasReal
          ? posts.map((post) => (
              <>
                <RecommendationListItem
                  title={post.title}
                  excerpt={post.excerpt}
                  internalHref={`/${post.category}/${post.slug}`}
                  externalUrl={post.externalUrl}
                  mainImage={post.mainImage}
                  authors={post.authors}
                />
                <Divider variant="rule" />
              </>
            ))
          : FAKE_RECS.map((rec) => (
              <>
                <RecommendationListItem
                  title={rec.title}
                  excerpt={rec.excerpt}
                  internalHref="#"
                  externalUrl={rec.externalUrl}
                  mainImage={null}
                  authors={rec.authors}
                />
                <Divider variant="rule" />
              </>
            ))
      }

      {
        !hasReal && (
          <p class="meta text-center mt-10 text-muted/80">
            Recomendações em curadoria · primeiras publicações em breve.
          </p>
        )
      }
    </section>

    {/* 4 · Disclaimer da categoria (se preenchido no Sanity) */}
    {
      category?.disclaimer && (
        <aside
          class="max-w-3xl mx-auto px-6 lg:px-12 pb-16 lg:pb-20"
          aria-label="Aviso editorial"
        >
          <div class="border-t border-rule/50 pt-8">
            <p class="font-sans text-[11px] font-medium tracking-[0.22em] uppercase text-rouge mb-3">
              Aviso editorial
            </p>
            <p class="font-serif text-[13px] lg:text-[14px] leading-[1.6] text-ink/65">
              {category.disclaimer}
            </p>
          </div>
        </aside>
      )
    }

    {/* 5 · Newsletter */}
    <NewsletterSection />
  </main>

  <Footer />
</Layout>
